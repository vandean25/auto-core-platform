      "second_result_overrides": { "source_account_ref": "SYNTH-ACCOUNT-002", "source_station_id": "SYNTH-STATION-002", "source_result_id": "SYNTH-RESULT-002", "source_revision": "SYNTH-OTHER-REV-2", "vehicle.vin": "WVWZZZ1JZXW000002", "vehicle.registration_plate": "SYNTH-002" },
