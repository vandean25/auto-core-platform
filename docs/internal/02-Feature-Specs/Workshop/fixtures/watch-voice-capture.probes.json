{
  "fixtureSet": "watch-voice-capture",
  "customerLabel": "pilot customer",
  "audioProbe": {
    "path": "apps/core-api/test/fixtures/watch-voice/synthetic-440hz.ogg",
    "generator": "ffmpeg -f lavfi -i sine=frequency=440:sample_rate=16000:duration=1 -c:a libopus -b:a 24k -ac 1 -ar 16000 -f ogg synthetic-440hz.ogg",
    "mimeType": "audio/ogg",
    "channels": 1,
    "sampleRateHertz": 16000,
    "durationSeconds": 1,
    "speech": "none — 440 Hz tone, not a voice and not a customer recording"
  },
  "ids": {
    "tenantId": "11111111-1111-4111-8111-111111111111",
    "siteId": "99999999-9999-4999-8999-999999999999",
    "mechanicEmployeeId": "44444444-4444-4444-8444-444444444444",
    "otherMechanicEmployeeId": "44444444-4444-4444-8444-444444444445",
    "taskId": "22222222-2222-4222-8222-222222222222",
    "otherTaskId": "22222222-2222-4222-8222-222222222223",
    "orderId": "33333333-3333-4333-8333-333333333333",
    "otherOrderId": "33333333-3333-4333-8333-333333333334",
    "permitId": "55555555-5555-4555-8555-555555555555",
    "clientRecordId": "66666666-6666-4666-8666-666666666666",
    "pairingId": "77777777-7777-4777-8777-777777777777",
    "draftId": "88888888-8888-4888-8888-888888888888",
    "challengeId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa"
  },
  "probes": [
    {
      "id": "pair-ok",
      "setup": "Browser session is TECH with an active mechanic employee and an active site. WATCH_GRANT_PEPPER is set.",
      "request": {
        "method": "POST",
        "route": "/api/mechanic/watch/pair",
        "auth": "none",
        "body": {
          "challengeId": "aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa",
          "code": "48291573",
          "deviceLabel": "Bay watch"
        }
      },
      "expect": {
        "status": 201,
        "body": {
          "tokenPrefix": "wvp_77777777-7777-4777-8777-777777777777_",
          "expiresInSeconds": 43200,
          "siteName": "Shop floor"
        },
        "storedOnWatch": ["grant token in Android Keystore ciphertext"],
        "neverStoredOnWatch": ["user password", "Firebase refresh token", "pairing code"]
      }
    },
    {
      "id": "pairing-expired",
      "setup": "Grant expires_at is in the past. revoked_at is null.",
      "request": {
        "method": "GET",
        "route": "/api/mechanic/watch/tasks",
        "auth": "Bearer wvp grant"
      },
      "expect": {
        "status": 401,
        "failureCode": "PAIRING_EXPIRED",
        "watchDeletesLocalQueue": true,
        "draftCreated": false
      }
    },
    {
      "id": "lost-device-revoke",
      "setup": "Browser POST /api/mechanic/watch-pairings/revoke with pairingId and reason LOST_DEVICE.",
      "request": {
        "method": "POST",
        "route": "/api/mechanic/watch/voice-notes",
        "auth": "Bearer revoked grant",
        "fields": {
          "permitId": "55555555-5555-4555-8555-555555555555",
          "clientRecordId": "66666666-6666-4666-8666-666666666666"
        }
      },
      "expect": {
        "status": 401,
        "failureCode": "PAIRING_REVOKED",
        "draftCreated": false,
        "watchDeletesLocalQueue": true
      }
    },
    {
      "id": "tenant-switch",
      "setup": "User.active_tenant_id no longer equals the grant tenant. The only customer string in this fixture set is the label pilot customer and it is not a column on the grant.",
      "request": {
        "method": "GET",
        "route": "/api/mechanic/watch/tasks",
        "auth": "Bearer grant for the previous tenant"
      },
      "expect": {
        "status": 401,
        "failureCode": "TENANT_MISMATCH",
        "grantRevokedReason": "TENANT_SWITCH",
        "draftCreated": false
      }
    },
    {
      "id": "assignment-revoked-while-offline",
      "setup": "Permit fingerprint was orderId + task.mechanic_id + order.mechanic_id. Before upload, task.mechanic_id is otherMechanicEmployeeId. Local audio file is unchanged.",
      "request": {
        "method": "POST",
        "route": "/api/mechanic/watch/voice-notes",
        "fields": {
          "permitId": "55555555-5555-4555-8555-555555555555",
          "clientRecordId": "66666666-6666-4666-8666-666666666666",
          "taskId": "22222222-2222-4222-8222-222222222223"
        }
      },
      "expect": {
        "status": 409,
        "failureCode": "ASSIGNMENT_CHANGED",
        "attachedTaskId": null,
        "draftCreated": false,
        "retry": "same failureCode, no second Speech-to-Text call"
      }
    },
    {
      "id": "task-closed-while-offline",
      "setup": "Permit task status is now DONE. Order and mechanic ids are unchanged.",
      "request": {
        "method": "POST",
        "route": "/api/mechanic/watch/voice-notes",
        "fields": {
          "permitId": "55555555-5555-4555-8555-555555555555",
          "clientRecordId": "66666666-6666-4666-8666-666666666666"
        }
      },
      "expect": {
        "status": 409,
        "failureCode": "TASK_CLOSED",
        "attachedTaskId": null,
        "draftCreated": false
      }
    },
    {
      "id": "order-changed-while-offline",
      "setup": "The task row's workshop_order_id is otherOrderId. The permit still names orderId.",
      "request": {
        "method": "POST",
        "route": "/api/mechanic/watch/voice-notes",
        "fields": {
          "permitId": "55555555-5555-4555-8555-555555555555",
          "clientRecordId": "66666666-6666-4666-8666-666666666666"
        }
      },
      "expect": {
        "status": 409,
        "failureCode": "ORDER_CHANGED",
        "attachedTaskId": null,
        "draftCreated": false
      }
    },
    {
      "id": "duplicate-delivery",
      "setup": "First upload stored WatchVoiceUpload ACCEPTED with draftId and content SHA-256 of synthetic-440hz.ogg. Speech-to-Text mock returned text once.",
      "request": {
        "method": "POST",
        "route": "/api/mechanic/watch/voice-notes",
        "replay": true,
        "fields": {
          "permitId": "55555555-5555-4555-8555-555555555555",
          "clientRecordId": "66666666-6666-4666-8666-666666666666"
        }
      },
      "expect": {
        "status": 200,
        "replay": true,
        "draftId": "88888888-8888-4888-8888-888888888888",
        "speechCalls": 1,
        "bodyOmits": ["text", "originalText", "customerName", "price"]
      }
    },
    {
      "id": "record-conflict",
      "setup": "Same clientRecordId already ACCEPTED. Second body has a different SHA-256.",
      "request": {
        "method": "POST",
        "route": "/api/mechanic/watch/voice-notes",
        "fields": {
          "clientRecordId": "66666666-6666-4666-8666-666666666666",
          "permitId": "55555555-5555-4555-8555-555555555555"
        }
      },
      "expect": {
        "status": 409,
        "failureCode": "RECORD_CONFLICT",
        "draftCount": 1
      }
    },
    {
      "id": "watch-projection-hides-pilot-customer",
      "setup": "The workshop order is for pilot customer. Task detail for the browser still includes plate and VIN. The watch query must not select those columns.",
      "request": {
        "method": "GET",
        "route": "/api/mechanic/watch/tasks",
        "auth": "Bearer active grant"
      },
      "expect": {
        "status": 200,
        "body": {
          "data": [
            {
              "taskId": "22222222-2222-4222-8222-222222222222",
              "sequence": 2,
              "taskTitle": "Front brake pads",
              "taskStatus": "IN_PROGRESS",
              "bayName": "Bay A"
            }
          ]
        },
        "forbiddenKeys": [
          "customerName",
          "price",
          "unitPrice",
          "plate",
          "vin",
          "orderNumber",
          "mechanicNotes",
          "reportedComplaint",
          "lineItems"
        ],
        "forbiddenSubstring": "pilot customer"
      }
    },
    {
      "id": "audio-bounds",
      "cases": [
        { "bytes": 99, "expect": 422, "failureCode": "AUDIO_TOO_SMALL" },
        { "bytes": 1048577, "expect": 413, "failureCode": "AUDIO_TOO_LARGE" },
        { "mimeType": "audio/mp4", "expect": 422, "failureCode": "AUDIO_MIME" },
        { "durationSeconds": 91, "mimeType": "audio/ogg", "expect": 422, "failureCode": "AUDIO_TOO_LONG" }
      ]
    },
    {
      "id": "browser-accepts-existing-review",
      "setup": "Watch upload created PENDING draft 88888888-8888-4888-8888-888888888888 with translated text 'Synthetic brake pad note.' The watch response did not include that text.",
      "request": {
        "method": "GET",
        "route": "/api/mechanic/tasks/22222222-2222-4222-8222-222222222222/voice-note-drafts/pending",
        "auth": "Firebase TECH session"
      },
      "then": {
        "method": "PATCH",
        "route": "/api/mechanic/tasks/22222222-2222-4222-8222-222222222222/diagnostics",
        "body": {
          "mechanicNotes": "Synthetic brake pad note.",
          "voiceNoteDraftId": "88888888-8888-4888-8888-888888888888"
        }
      },
      "expect": {
        "draftStatus": "ACCEPTED",
        "notes": "Synthetic brake pad note.",
        "watchNeverRenderedTranscript": true
      }
    }
  ]
}
