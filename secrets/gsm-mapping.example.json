  {
  "projectId": "auto-core-platform-vande",
  "targets": [
    {
      "name": "core-api",
      "output": "apps/core-api/.env",
      "secrets": {
        "DATABASE_URL": "acp-core-api-database-url"
      }
    },
    {
      "name": "core-web",
      "output": "apps/core-web/.env.local",
      "secrets": {
        "VITE_FIREBASE_API_KEY": "acp-web-firebase-api-key",
        "VITE_FIREBASE_AUTH_DOMAIN": "acp-web-firebase-auth-domain",
        "VITE_FIREBASE_PROJECT_ID": "acp-web-firebase-project-id",
        "VITE_FIREBASE_APP_ID": "acp-web-firebase-app-id"
      }
    }
  ]
}

