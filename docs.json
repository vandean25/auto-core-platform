{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Auto Core Platform",
  "theme": "willow",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "/introduction"
  },
  "favicon": "/images/favicon.svg",
  "seo": {
    "metatags": {
      "description": "Guides for Auto Core Platform — workshop and dealer software for Austria and DACH: jobs, parts, invoices, and settings.",
      "og:title": "Auto Core Platform documentation",
      "og:description": "Role-based help for service advisors, mechanics, accounting, and owners using Auto Core Platform.",
      "og:site_name": "Auto Core Platform",
      "twitter:card": "summary",
      "twitter:title": "Auto Core Platform documentation",
      "twitter:description": "Workshop and dealer DMS guides for Austria and DACH."
    }
  },
  "integrations": {
    "telemetry": {
      "enabled": true
    }
  },
  "colors": {
    "primary": "#0F172A",
    "light": "#38BDF8",
    "dark": "#38BDF8"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Sora",
      "weight": 600
    },
    "body": {
      "family": "IBM Plex Sans"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#F8FAFC",
      "dark": "#020617"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "type": "github",
        "href": "https://github.com/vandean25/auto-core-platform"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Live demo",
      "href": "https://auto-core-platform-vande.web.app/"
    }
  },
  "banner": {
    "content": "Try the [live demo](https://auto-core-platform-vande.web.app/) or browse the [source on GitHub](https://github.com/vandean25/auto-core-platform).",
    "dismissible": true,
    "type": "info"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/vandean25/auto-core-platform"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Live demo",
            "href": "https://auto-core-platform-vande.web.app/"
          },
          {
            "label": "GitHub",
            "href": "https://github.com/vandean25/auto-core-platform"
          }
        ]
      }
    ]
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["introduction", "changelog", "quickstart", "workflows"]
          },
          {
            "group": "Daily work",
            "pages": ["workflows/sign-in", "workflows/dashboard"]
          },
          {
            "group": "People",
            "pages": ["hr"]
          },
          {
            "group": "Sales",
            "pages": [
              "workflows/customers",
              "workflows/vehicles",
              "workflows/sales-orders",
              "workflows/invoices"
            ]
          },
          {
            "group": "Finance",
            "pages": [
              "workflows/credit-notes",
              "workflows/accounting-export",
              "settings/document-branding"
            ]
          },
          {
            "group": "Workshop",
            "pages": [
              "workflows/workshop-intake",
              "workflows/workshop-orders",
              "workflows/workshop-check-in",
              "workflows/warranty-claims",
              "workflows/workshop-planner",
              "workflows/workshop-board",
              "workflows/workshop-pick",
              "workflows/mechanic",
              "workflows/workshop-capacity",
              "workflows/workshop-kpis",
              "workflows/loaner-vehicles",
              "workflows/tyre-storage"
            ]
          },
          {
            "group": "Vehicles and trading",
            "pages": [
              "workflows/vehicle-stock",
              "workflows/listings-export"
            ]
          },
          {
            "group": "Austria compliance",
            "pages": [
              "workflows/pickerl-due",
              "workflows/nova",
              "workflows/statutory-warranty-due"
            ]
          },
          {
            "group": "Inventory",
            "pages": [
              "workflows/inventory",
              "workflows/stock-transfers"
            ]
          },
          {
            "group": "Procurement",
            "pages": [
              "workflows/vendors",
              "workflows/purchase-orders",
              "workflows/purchase-bills"
            ]
          },
          {
            "group": "Platform",
            "pages": [
              "workflows/platform-tenants",
              "workflows/sites",
              "workflows/agent-supervision"
            ]
          }
        ]
      },
      {
        "tab": "Settings",
        "icon": "settings",
        "groups": [
          {
            "group": "All settings",
            "pages": ["settings"]
          },
          {
            "group": "Finance",
            "pages": [
              "settings/finance",
              "settings/legal-entities",
              "settings/document-branding",
              "settings/revenue-groups"
            ]
          },
          {
            "group": "Organization",
            "pages": ["settings/sites"]
          },
          {
            "group": "Workshop",
            "pages": [
              "settings/employees",
              "settings/bays",
              "settings/labor",
              "settings/voice-translation"
            ]
          },
          {
            "group": "Master data",
            "pages": [
              "settings/brands",
              "settings/storage-locations",
              "settings/vehicle-data",
              "settings/margin-rules"
            ]
          },
          {
            "group": "Access",
            "pages": ["settings/team"]
          },
          {
            "group": "Integrations",
            "pages": ["settings/data-import", "settings/api-keys"]
          },
          {
            "group": "Audit & compliance",
            "pages": ["settings/audit-logs"]
          }
        ]
      },
      {
        "tab": "Operations",
        "icon": "activity",
        "groups": [
          {
            "group": "Diagnostics",
            "pages": [
              "operations/runtime-diagnostics",
              "operations/core-api-scheduled-jobs"
            ]
          }
        ]
      }
    ]
  }
}
