      "twitter:card": "summary",
      "twitter:title": "Auto Core Platform Dokumentation",
      "twitter:description": "Werkstatt- und Händler-DMS-Hilfe für Österreich und DACH."
    }
  },
  "integrations": {
    "telemetry": {
      "enabled": true
    }
  },
  "colors": {
    "primary": "#0F172A",
    "light": "#38BDF8",
    "dark": "#38BDF8"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Sora",
      "weight": 600
    },
    "body": {
