{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Auto Core Platform",
  "theme": "willow",
  "logo": {
    "light": "/images/logo-light.svg",
    "dark": "/images/logo-dark.svg",
    "href": "/introduction"
  },
  "favicon": "/images/favicon.svg",
  "seo": {
    "metatags": {
      "description": "Hilfe für Auto Core Platform — Werkstatt- und Händlersoftware für Österreich und DACH: Aufträge, Teile, Rechnungen und Einstellungen.",
