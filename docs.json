{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Auto Core Platform",
  "theme": "willow",
  "colors": {
    "primary": "#0F172A",
    "light": "#38BDF8",
    "dark": "#38BDF8"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "heading": {
      "family": "Sora",
      "weight": 600
    },
    "body": {
      "family": "IBM Plex Sans"
    }
  },
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#F8FAFC",
      "dark": "#020617"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Live demo",
        "href": "https://auto-core-platform-vande.web.app/"
      },
      {
        "type": "github",
        "href": "https://github.com/vandean25/auto-core-platform"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Live demo",
      "href": "https://auto-core-platform-vande.web.app/"
    }
  },
  "banner": {
    "content": "Try the [live demo](https://auto-core-platform-vande.web.app/) or browse the [source on GitHub](https://github.com/vandean25/auto-core-platform).",
    "dismissible": true,
    "type": "info"
  },
  "footer": {
    "socials": {
      "github": "https://github.com/vandean25/auto-core-platform"
    },
    "links": [
      {
        "header": "Product",
        "items": [
          {
            "label": "Live demo",
            "href": "https://auto-core-platform-vande.web.app/"
          },
          {
            "label": "GitHub",
            "href": "https://github.com/vandean25/auto-core-platform"
          }
        ]
      }
    ]
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Live demo",
          "icon": "play",
          "href": "https://auto-core-platform-vande.web.app/"
        },
        {
          "anchor": "GitHub",
          "icon": "github",
          "href": "https://github.com/vandean25/auto-core-platform"
        }
      ]
    },
    "tabs": [
      {
        "tab": "Guides",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["introduction", "quickstart", "workflows"]
          },
          {
            "group": "Daily work",
            "pages": ["workflows/sign-in", "workflows/dashboard"]
          },
          {
            "group": "People",
            "pages": ["hr"]
          },
          {
            "group": "Sales",
            "pages": [
              "workflows/customers",
              "workflows/vehicles",
              "workflows/sales-orders",
              "workflows/invoices"
            ]
          },
          {
            "group": "Workshop",
            "pages": [
              "workflows/workshop-intake",
              "workflows/workshop-orders",
              "workflows/workshop-board",
              "workflows/workshop-pick",
              "workflows/mechanic"
            ]
          },
          {
            "group": "Inventory",
            "pages": ["workflows/inventory"]
          },
          {
            "group": "Procurement",
            "pages": [
              "workflows/vendors",
              "workflows/purchase-orders",
              "workflows/purchase-bills"
            ]
          },
          {
            "group": "Platform",
            "pages": ["workflows/platform-tenants"]
          }
        ]
      },
      {
        "tab": "Settings",
        "icon": "settings",
        "groups": [
          {
            "group": "All settings",
            "pages": ["settings"]
          },
          {
            "group": "Finance",
            "pages": ["settings/finance", "settings/revenue-groups"]
          },
          {
            "group": "Workshop",
            "pages": [
              "settings/employees",
              "settings/bays",
              "settings/labor",
              "settings/voice-translation"
            ]
          },
          {
            "group": "Master data",
            "pages": ["settings/brands", "settings/storage-locations"]
          },
          {
            "group": "Access",
            "pages": ["settings/team"]
          },
          {
            "group": "Audit & compliance",
            "pages": ["settings/audit-logs"]
          }
        ]
      },
      {
        "tab": "Operations",
        "icon": "activity",
        "groups": [
          {
            "group": "Diagnostics",
            "pages": ["operations/runtime-diagnostics"]
          }
        ]
      }
    ]
  }
}
