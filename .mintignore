# Application and infrastructure code — not part of the public Mintlify site.
# Mintlify auto-includes every .css/.js file in the content directory; without
# these exclusions, core-web Tailwind CSS and eslint config leak into docs pages
# and break client-side behavior (including the theme switcher).
apps/
infra/
tools/
test-results/
secrets/

# Monorepo engineering tree (ADRs, runbooks, superpowers plans/specs, ops notes).
# Public Mintlify pages live at the repo root only: *.mdx here plus workflows/, settings/, operations/.
docs/

# Agent workflow artifacts — not user-facing documentation.
.superpowers/
.agents/

# Repository and GitHub-only markdown.
.github/
README.md

# Large API discovery dumps and repo metadata — not user-facing docs assets.
identitytoolkit-v1-discovery.json
identitytoolkit-v2-discovery.json
cloudbuild.yaml
cloudbuild.staging.yaml
pr_description.md
agents.md
CLAUDE.md
.claude/
