{
  "name": "auto-core-platform",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22",
    "npm": ">=9"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "build": "npm exec --workspace=core-api -- prisma generate && npm run build --workspaces --if-present",
    "test": "npm exec --workspace=core-api -- prisma generate && npm test --workspaces --if-present",
    "lint": "npm exec --workspace=core-api -- prisma generate && npm run lint --workspaces --if-present",
    "tenant-restore:verify": "node tools/tenant-restore/verify-table-list.mjs && node --test tools/tenant-restore/tenant-schema.test.mjs tools/tenant-restore/restore-guards.test.mjs tools/tenant-restore/dump-validation.test.mjs",
    "docs:verify-mintignore": "node tools/verify-mintignore.mjs",
    "docs:verify-site": "node tools/verify-mintlify-site.mjs",
    "build:verify-chunks": "node tools/verify-build-chunks.mjs --dist apps/core-web/dist",
    "build:verify-chunks:test": "node --test tools/verify-build-chunks.test.mjs",
    "repowise:health": "uvx --from repowise==0.49.0 repowise health",
    "repowise:dead-code": "uvx --from repowise==0.49.0 repowise dead-code",
    "repowise:serve": "uvx --from repowise==0.49.0 repowise serve --port 7338",
    "repowise:update": "uvx --from repowise==0.49.0 repowise update",
    "agent-eval": "npm run agent-eval --workspace=core-api",
    "ci": "npm run lint && npm test && npm run build",
    "test:e2e:fullstack": "npm run test:e2e:fullstack --workspace=core-web"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@~7.0.2",
    "tsx": "^4.23.13",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "openapi-typescript": {
      "typescript": "npm:@typescript/typescript6@^6.0.2"
    },
    "multer": "2.3.0",
    "mysql2": "^3.24.4",
    "uuid": "^11.1.1",
    "deepmerge-ts": "^8.0.2",
    "js-yaml": "^4.3.2"
  }
}
