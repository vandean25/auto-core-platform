# Production values are intentionally separate from the current UAT/live release.
project_id                       = "auto-core-platform"
region                           = "europe-west3"
service_name                     = "core-api"
deployment_environment           = "production"
container_image                  = "europe-west3-docker.pkg.dev/auto-core-platform/core-services/core-api:REPLACE_WITH_TAG"
frontend_url                     = "https://auto-core-platform-vande.web.app"
sentry_release                   = "REPLACE_WITH_RELEASE_TAG"
cloud_tasks_target_base_url      = "https://PRODUCTION_PDF_WORKER_URL/api"
database_secret_name             = "DATABASE_URL_PROD"
database_pooled_secret_name      = "acp-core-api-database-url-pooled-prod"
database_pooler_required         = false
firebase_project_id              = "auto-core-platform-vande"
