{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src"
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "**/*.spec.support.ts",
    "**/*.spec.matcher.ts",
    "**/*.spec.matcher.*.ts",
    "**/*.spec.fixtures.ts",
    "prisma/**/*.ts"
  ]
}
