model WorkshopInspectionItem {
  id                          String                     @id @default(uuid())
  tenant_id                   String
  tenant                      Tenant                     @relation(fields: [tenant_id], references: [id])
  workshop_inspection_id      String
  workshop_inspection         WorkshopInspection         @relation(fields: [tenant_id, workshop_inspection_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade)
  inspection_template_item_id String?
  inspection_template_item    InspectionTemplateItem?    @relation(fields: [tenant_id, inspection_template_item_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Cascade)
  label_snapshot              String
  response_value              String?
  unit                        String?
  passed                      Boolean?
  severity                    WorkshopInspectionSeverity?
  notes                       String?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, id])
  @@index([tenant_id, workshop_inspection_id], map: "idx_workshop_inspection_items_inspection")
  @@index([tenant_id, inspection_template_item_id], map: "idx_workshop_inspection_items_template_item")
  @@map("workshop_inspection_items")
}

model WorkshopMedia {
  id                      String                   @id @default(uuid())
  tenant_id               String
  tenant                  Tenant                   @relation(fields: [tenant_id], references: [id])
  workshop_order_id       String
  workshop_order          WorkshopOrder            @relation(fields: [tenant_id, workshop_order_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade)
  workshop_task_id        String?
  workshop_task           WorkshopTask?            @relation(fields: [tenant_id, workshop_task_id], references: [tenant_id, id], onDelete: SetNull, onUpdate: Cascade)
  uploaded_by_employee_id String
  uploaded_by_employee    Employee                 @relation("WorkshopMediaUploadedByEmployee", fields: [tenant_id, uploaded_by_employee_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Cascade)
  storage_bucket          String
  storage_key             String
  url_strategy            WorkshopMediaUrlStrategy
  mime_type               String
  size_bytes              Int
  duration_seconds        Decimal?                 @db.Decimal(10, 2)
  caption                 String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, id])
  @@index([tenant_id, workshop_order_id], map: "idx_workshop_media_order")
  @@index([tenant_id, workshop_task_id], map: "idx_workshop_media_task")
  @@index([tenant_id, uploaded_by_employee_id], map: "idx_workshop_media_employee")
  @@map("workshop_media")
}

model WorkshopVoiceNoteDraft {
  id                      String                      @id @default(uuid())
  tenant_id               String
  tenant                  Tenant                      @relation(fields: [tenant_id], references: [id])
  workshop_task_id        String
  workshop_task           WorkshopTask                @relation(fields: [tenant_id, workshop_task_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade)
  mechanic_employee_id    String
  mechanic_employee       Employee                    @relation("CreatedVoiceNoteDrafts", fields: [tenant_id, mechanic_employee_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Cascade)
  status                  WorkshopVoiceNoteDraftStatus @default(PENDING)
  source_language_code    String?
  target_language_code    String
  original_text           String
  translated_text         String
  provider                String
  model                   String
  duration_seconds        Decimal?                    @db.Decimal(10, 2)
  accepted_at             DateTime?
  accepted_by_employee_id String?
  accepted_by_employee    Employee?                   @relation("AcceptedVoiceNoteDrafts", fields: [tenant_id, accepted_by_employee_id], references: [tenant_id, id], onDelete: SetNull, onUpdate: Cascade)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  @@index([tenant_id])
  @@index([tenant_id, workshop_task_id], map: "idx_workshop_voice_note_drafts_task")
  @@index([tenant_id, mechanic_employee_id], map: "idx_workshop_voice_note_drafts_mechanic")
  @@map("workshop_voice_note_drafts")
}

model VoiceNoteRateLimit {
  tenant_id    String
  tenant       Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  mechanic_id  String
  mechanic     Employee @relation(fields: [tenant_id, mechanic_id], references: [tenant_id, id], onDelete: Cascade)
  window_start DateTime
  expires_at   DateTime
  count        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([tenant_id, mechanic_id])
  @@index([tenant_id])
  @@index([expires_at])
  @@map("voice_note_rate_limits")
}

// ============================================================================
// Labor Time Tracking
// ============================================================================

model LaborEntry {
  id               String            @id @default(uuid())
  tenant_id        String
  tenant           Tenant            @relation(fields: [tenant_id], references: [id])
  workshop_task_id String
  workshop_task    WorkshopTask      @relation(fields: [tenant_id, workshop_task_id], references: [tenant_id, id], onDelete: Restrict)
  employee_id      String
  employee         Employee          @relation("EmployeeLaborEntries", fields: [tenant_id, employee_id], references: [tenant_id, id], onDelete: Restrict)

  started_at       DateTime
  ended_at         DateTime?
  pause_reason     LaborPauseReason?

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@index([workshop_task_id])
  @@index([employee_id])
  @@index([ended_at], map: "labor_entries_ended_at_idx")
  @@map("labor_entries")
}

model LaborCategory {
  id                  String            @id @default(uuid()) @db.Uuid
  tenant_id           String
  tenant              Tenant            @relation(fields: [tenant_id], references: [id])
  name                String
  description         String?
  sort_order          Int               @default(0)
  parent_id           String?           @db.Uuid
  parent              LaborCategory?    @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children            LaborCategory[]   @relation("CategoryHierarchy")
  is_active           Boolean           @default(true)
  default_hourly_rate Decimal?          @db.Decimal(10, 2)
  default_internal_cost_rate Decimal?   @db.Decimal(10, 2)

  labor_operations    LaborOperation[]
  catalogProviderSettings CatalogProviderSettings[]
  workshop_task_line_items WorkshopTaskLineItem[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("labor_categories")
  @@index([tenant_id])
  @@unique([tenant_id, name]) // tenant-scoped
  @@index([parent_id])
}

model LaborOperation {
  id            String         @id @default(uuid()) @db.Uuid
  tenant_id     String
  tenant        Tenant         @relation(fields: [tenant_id], references: [id])
  code          String
  description   String
  standard_aw   Decimal        @db.Decimal(10, 2)
  hourly_rate   Decimal        @db.Decimal(10, 2)
  internal_cost Decimal?       @db.Decimal(10, 2)
  category_id   String?        @db.Uuid
  category      LaborCategory? @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  is_active     Boolean        @default(true)
  fitments      LaborFitment[]
  task_line_items WorkshopTaskLineItem[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("labor_operations")
  @@index([tenant_id])
  @@unique([tenant_id, code]) // tenant-scoped
  @@index([description])
  @@index([code, description])
  @@index([category_id])
  @@index([is_active, description], name: "labor_operations_is_active_description_idx")
}

model LaborFitment {
  id                 String         @id @default(uuid()) @db.Uuid
  labor_operation_id String         @db.Uuid
  labor_operation    LaborOperation @relation(fields: [labor_operation_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  make               String
  model              String
  year_from          Int?
  year_to            Int?
  engine_code        String?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("labor_fitments")
  @@index([labor_operation_id])
  @@index([make, model, year_from, year_to, engine_code])
}

model MasterPart {
  id                   String          @id @default(uuid()) @db.Uuid
  supplier_part_number String          @unique
  oem_number           String?
  description          String
  brand                String
  fitments             PartFitment[]
  local_inventory      LocalInventory?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("master_parts")
  @@index([description])
  @@index([supplier_part_number, oem_number, description])
}

model PartFitment {
  id             String     @id @default(uuid()) @db.Uuid
  master_part_id String     @db.Uuid
  master_part    MasterPart @relation(fields: [master_part_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  make           String
  model          String
  year_from      Int?
  year_to        Int?
  engine_code    String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("part_fitments")
  @@index([master_part_id])
  @@index([make, model, year_from, year_to, engine_code])
}

model LocalInventory {
  id               String     @id @default(uuid()) @db.Uuid
  master_part_id   String     @unique @db.Uuid
  master_part      MasterPart @relation(fields: [master_part_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quantity_on_hand Int        @default(0)
  bin_location     String?
  cost_price       Decimal    @db.Decimal(10, 2)
  retail_price     Decimal    @db.Decimal(10, 2)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("local_inventories")
  @@index([quantity_on_hand])
}
