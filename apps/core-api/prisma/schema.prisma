/// AUT-411 tenant API key for the read-only public API (ADR-0026).
/// Only a scrypt digest of the secret is stored; the plaintext secret is returned once at creation.
model TenantApiKey {
  id                     String    @id @default(uuid())
  tenant_id              String
  tenant                 Tenant    @relation(fields: [tenant_id], references: [id])
  name                   String
  /// Display-only prefix (`acp_live_` + first 8 characters of id). Never used for authentication.
  key_prefix             String
  /// scrypt digest of the secret (pepper as salt), hex. Never the plaintext secret.
  secret_hash            String
  /// Pepper derivation version (ADR-0026 rotation). Bump when the pepper or digest algorithm changes.
  hash_version           Int       @default(1)
  scopes                 String[]  @default([])
  created_by_user_id     String?
  created_by             User?     @relation("TenantApiKeyCreatedBy", fields: [created_by_user_id], references: [id], onDelete: SetNull)
  revoked_by_user_id     String?
  revoked_by             User?     @relation("TenantApiKeyRevokedBy", fields: [revoked_by_user_id], references: [id], onDelete: SetNull)
  created_at             DateTime  @default(now())
  last_used_at           DateTime?
  expires_at             DateTime?
  revoked_at             DateTime?
  /// Fixed-window request counter (one-minute windows). Reset atomically when the window expires.
  rate_window_count      Int       @default(0)
  rate_window_expires_at DateTime?

  @@index([tenant_id, created_at])
  @@map("tenant_api_keys")
}

