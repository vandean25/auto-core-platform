  type              WorkshopLineItemType
  part_execution_status WorkshopPartLineExecutionStatus?
  // For PART this stores SKU/part number; for LABOR this stores a labor code.
  item_no           String
  description       String
  quantity          Decimal              @db.Decimal(10, 2)
  unit_price        Decimal              @db.Decimal(10, 2)
  catalog_item_id   String?
  catalog_item      CatalogItem?         @relation(fields: [catalog_item_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  source_system     String?
  external_operation_code String?
  fitment_notes     String?
  cost_price_est    Decimal?             @db.Decimal(10, 2)
  oem_numbers       Json?
  labor_category_id String?              @db.Uuid
  labor_category    LaborCategory?       @relation(fields: [labor_category_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  hourly_rate_snapshot Decimal?          @db.Decimal(10, 2)
  catalog_hit_jti   String?
  labor_operation_id String?             @db.Uuid
  labor_operation    LaborOperation?     @relation(fields: [labor_operation_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  standard_aw        Decimal?            @db.Decimal(10, 2)
  actual_hours       Decimal?            @db.Decimal(10, 2)
  internal_cost_rate Decimal?            @db.Decimal(10, 2)

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("workshop_task_line_items")
  @@index([tenant_id])
  @@index([labor_operation_id])
  @@index([catalog_item_id])
  @@index([labor_category_id])
  @@index([tenant_id, type, part_execution_status], map: "idx_workshop_task_line_items_part_status")
}

