enum WorkshopEstimateStatus {
  DRAFT
  SENT
  APPROVED
  DECLINED
  EXPIRED
  SUPERSEDED
}

/// KV-YYYY-XXXX counter per tenant and calendar year (ADR-0009 pattern).
model WorkshopEstimateSequence {
  id        String @id @default(uuid())
  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])
  year      Int
  current   Int    @default(0)

  @@unique([tenant_id, year])
  @@index([tenant_id])
  @@map("workshop_estimate_sequences")
}

/// One Kostenvoranschlag per workshop order (ADR-0025 §1). Revisions add
/// versions; the estimate number never changes.
model WorkshopEstimate {
  id                String                    @id @default(uuid())
  tenant_id         String
  tenant            Tenant                    @relation(fields: [tenant_id], references: [id])
  site_id           String
  site              Site                      @relation(fields: [tenant_id, site_id], references: [tenant_id, id])
  workshop_order_id String
  workshop_order    WorkshopOrder             @relation(fields: [tenant_id, workshop_order_id], references: [tenant_id, id], onDelete: Restrict)
  estimate_number   String
  year              Int
  versions          WorkshopEstimateVersion[]
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([tenant_id, id])
  @@unique([tenant_id, estimate_number])
  @@unique([tenant_id, workshop_order_id])
  @@index([tenant_id])
  @@index([tenant_id, site_id])
  @@map("workshop_estimates")
}

/// Versioned estimate content. A DRAFT is live (built from the order when sent);
/// SENT and later rows carry the immutable snapshot, its hash and the PDF archive
/// (ADR-0025 §2 and §4). Only the status and PDF columns change after send.
model WorkshopEstimateVersion {
  id                     String                              @id @default(uuid())
  tenant_id              String
  tenant                 Tenant                              @relation(fields: [tenant_id], references: [id])
  estimate_id            String
  estimate               WorkshopEstimate                    @relation(fields: [tenant_id, estimate_id], references: [tenant_id, id], onDelete: Restrict)
  version                Int
  status                 WorkshopEstimateStatus             @default(DRAFT)
  legal_entity_id        String?
  legal_entity           LegalEntity?                        @relation(fields: [tenant_id, legal_entity_id], references: [tenant_id, id])
  sent_at                DateTime?
  valid_from             DateTime?
  valid_until            DateTime?
  total_net              Decimal?                            @db.Decimal(10, 2)
  total_tax              Decimal?                            @db.Decimal(10, 2)
  total_gross            Decimal?                            @db.Decimal(10, 2)
  snapshot               Json?
  snapshot_sha256        String?
  legal_text_version     String?
  legal_text_sha256      String?
  retain_until           DateTime?
  legal_hold             Boolean                             @default(false)
  pdf_storage_bucket     String?
  pdf_storage_key        String?
  pdf_archive_generation String?
  pdf_sha256             String?
  pdf_generated_at       DateTime?
  pdf_generation_error   String?
  brand_asset_reference  WorkshopEstimateBrandAssetReference?
  approval_tokens        WorkshopEstimateApprovalToken[]
  approvals              WorkshopEstimateApproval[]
  overruns               WorkshopEstimateOverrun[]
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt

  @@unique([tenant_id, id])
  @@unique([tenant_id, estimate_id, version])
  @@index([tenant_id])
  @@index([tenant_id, estimate_id, status])
  @@index([tenant_id, legal_entity_id, sent_at], map: "wev_entity_sent_idx")
  @@map("workshop_estimate_versions")
}

/// Pins the frozen logo asset of a sent estimate version, so asset cleanup
/// cannot remove it (ADR-0025 §3, "referenced assets are retained").
model WorkshopEstimateBrandAssetReference {
  id                           String                  @id @default(uuid())
  tenant_id                    String
  tenant                       Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Restrict, map: "weba_tenant_fkey")
  legal_entity_id              String
  legal_entity                 LegalEntity             @relation(fields: [tenant_id, legal_entity_id], references: [tenant_id, id], onDelete: Restrict, map: "weba_entity_fkey")
  workshop_estimate_version_id String
  version                      WorkshopEstimateVersion @relation(fields: [tenant_id, workshop_estimate_version_id], references: [tenant_id, id], onDelete: Restrict, map: "weba_version_fkey")
  asset_id                     String
  asset                        DocumentBrandAsset      @relation(fields: [tenant_id, legal_entity_id, asset_id], references: [tenant_id, legal_entity_id, id], onDelete: Restrict, map: "weba_asset_fkey")
  createdAt                    DateTime                @default(now())

  @@unique([tenant_id, id], map: "weba_tenant_id_uq")
  @@unique([tenant_id, workshop_estimate_version_id], map: "weba_tenant_version_uq")
  @@index([tenant_id])
  @@index([tenant_id, legal_entity_id, asset_id], map: "weba_asset_scope_idx")
  @@map("workshop_estimate_brand_asset_references")
}

/// One approval token for a sent estimate version (ADR-0025 §7). Only the SHA-256 of the token is stored,
/// never the token itself. The token expires at the version's valid_until. Superseding the version, when a
/// later version is sent, invalidates its tokens. Approval consumes the token once (a later phase).
model WorkshopEstimateApprovalToken {
  id                           String                  @id @default(uuid())
  tenant_id                    String
  tenant                       Tenant                  @relation(fields: [tenant_id], references: [id], onDelete: Restrict, map: "wat_tenant_fkey")
  workshop_estimate_version_id String
  version                      WorkshopEstimateVersion @relation(fields: [tenant_id, workshop_estimate_version_id], references: [tenant_id, id], onDelete: Restrict, map: "wat_version_fkey")
  token_sha256                 String
  expires_at                   DateTime
  invalidated_at               DateTime?
  consumed_at                  DateTime?
  createdAt                    DateTime                @default(now())
  approvals                    WorkshopEstimateApproval[]

  @@unique([tenant_id, id], map: "wat_tenant_id_uq")
  @@unique([tenant_id, token_sha256], map: "wat_tenant_token_sha256_uq")
  @@index([token_sha256], map: "wat_token_sha256_idx")
  @@index([tenant_id])
  @@index([tenant_id, workshop_estimate_version_id], map: "wat_version_idx")
  @@map("workshop_estimate_approval_tokens")
}

/// How a decision reached the workshop. LINK is the customer's own link (token evidence). PHONE, IN_PERSON and
/// EMAIL are advisor-recorded (AUT-355). ADVISOR_RECORDED is legacy: nothing writes it, and enum values are not
/// removed in v1 (ADR-0025 §11).
enum EstimateApprovalChannel {
  LINK
  ADVISOR_RECORDED
  PHONE
  IN_PERSON
  EMAIL
}

/// The customer's reaction, recorded by the advisor with a decision or with an overrun notice (AUT-355).
enum EstimateCustomerReaction {
  AGREED
  DECLINED
  QUESTIONED
  CALLBACK_REQUESTED
  NO_RESPONSE
}

/// Channel of the advisor's notice to the customer about an overrun (AUT-355). The link is not a channel here.
enum EstimateNotificationChannel {
  PHONE
  IN_PERSON
  EMAIL
}

enum EstimateApprovalDecision {
  APPROVED
  DECLINED
}

// Evidence for one decision on a sent estimate version (ADR-0025 §7). Append-only: the API never updates or
// deletes a row. One decision per version, enforced by wea_tenant_version_uq. Expand-only: a new table, and no
// existing row changes.
model WorkshopEstimateApproval {
  id                               String                         @id @default(uuid())
  tenant_id                        String
  tenant                           Tenant                         @relation(fields: [tenant_id], references: [id], onDelete: Restrict, map: "wea_tenant_fkey")
  workshop_estimate_version_id     String
  version                          WorkshopEstimateVersion        @relation(fields: [tenant_id, workshop_estimate_version_id], references: [tenant_id, id], onDelete: Restrict, map: "wea_version_fkey")
  approval_token_id                String?
  approval_token                   WorkshopEstimateApprovalToken? @relation(fields: [tenant_id, approval_token_id], references: [tenant_id, id], onDelete: Restrict, map: "wea_token_fkey")
  channel                          EstimateApprovalChannel
  decision                         EstimateApprovalDecision
  decided_at                       DateTime
  content_sha256                   String
  pdf_sha256                       String?
  legal_text_version               String
  legal_text_sha256                String
  recipient_email                  String?
  typed_full_name                  String?
  legal_blocks_accepted            Boolean                        @default(false)
  b2c_declaration_accepted         Boolean                        @default(false)
  ip_address                       String?
  user_agent                       String?
  accept_language                  String?
  confirmation_email_sent_at       DateTime?
  confirmation_provider_message_id String?
  amount_quoted_gross              Decimal?                       @db.Decimal(10, 2)
  customer_reaction                EstimateCustomerReaction?
  note                             String?                        @db.VarChar(500)
  recorded_by_user_id              String?
  recorded_by_user                 User?                          @relation("WorkshopEstimateApprovalRecordedBy", fields: [recorded_by_user_id], references: [id], onDelete: SetNull)
  createdAt                        DateTime                       @default(now())

  @@unique([tenant_id, id], map: "wea_tenant_id_uq")
  @@unique([tenant_id, workshop_estimate_version_id], map: "wea_tenant_version_uq")
  @@index([tenant_id])
  @@map("workshop_estimate_approvals")
}

/// Overrun state of one approved baseline (AUT-355, ADR-0025 §1). Written once when the live order first goes over
/// the guide (gross over the approved total times (1 + threshold), or work lines the approved version did not
/// contain). It also holds the advisor's notice to the customer. A revised version that is approved starts a new
/// baseline and therefore a new row. Retention and legal hold follow the baseline version.
model WorkshopEstimateOverrun {
  id                           String                       @id @default(uuid())
  tenant_id                    String
  tenant                       Tenant                       @relation(fields: [tenant_id], references: [id], onDelete: Restrict, map: "weo_tenant_fkey")
  workshop_estimate_version_id String
  version                      WorkshopEstimateVersion      @relation(fields: [tenant_id, workshop_estimate_version_id], references: [tenant_id, id], onDelete: Restrict, map: "weo_version_fkey")
  detected_at                  DateTime
  approved_total_gross         Decimal                      @db.Decimal(10, 2)
  detected_total_gross         Decimal                      @db.Decimal(10, 2)
  total_over_threshold         Boolean                      @default(false)
  new_work_lines               Boolean                      @default(false)
  notified_at                  DateTime?
  notified_channel             EstimateNotificationChannel?
  notified_by_user_id          String?
  notified_by_user             User?                        @relation("WorkshopEstimateOverrunNotifiedBy", fields: [notified_by_user_id], references: [id], onDelete: SetNull)
  notified_amount_gross        Decimal?                     @db.Decimal(10, 2)
  customer_reaction            EstimateCustomerReaction?
  note                         String?                      @db.VarChar(500)
  createdAt                    DateTime                     @default(now())
  updatedAt                    DateTime                     @updatedAt

  @@unique([tenant_id, id], map: "weo_tenant_id_uq")
  @@unique([tenant_id, workshop_estimate_version_id], map: "weo_tenant_version_uq")
  @@index([tenant_id])
  @@map("workshop_estimate_overruns")
}

/// Event types that write the notification outbox (ADR-0025 §6, AUT-356, AUT-355). Enum additions only.
enum NotificationEventType {
  WORKSHOP_TASK_WAITING_CUSTOMER
  CUSTOMER_ESTIMATE_SENT
  CUSTOMER_ESTIMATE_DECIDED
  WORKSHOP_ORDER_READY
  LANDING_DEMO_MAGIC_LINK
  LANDING_DEMO_OPERATOR_ALERT
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationRecipientKind {
  INTERNAL_TEAM
  CUSTOMER
}

enum NotificationMessageClass {
  TRANSACTIONAL
}

enum NotificationOutboxStatus {
  PENDING
  SENDING
  ACCEPTED
  FAILED
  SUPPRESSED
}

/// Transactional outbox (ADR-0025 §6, AUT-356). A domain mutation writes its row in the same
/// transaction as the state change; the Cloud Tasks message is only a wake-up and the row is the
/// durable record. `idempotency_key` (event + recipient + channel) makes a repeated write a no-op.
/// Bodies are purged 90 days after creation; metadata is kept (ADR-0025 §10).
model NotificationOutbox {
  id                  String                    @id @default(uuid())
  tenant_id           String
  tenant              Tenant                    @relation(fields: [tenant_id], references: [id])
  event_type          NotificationEventType
  idempotency_key     String
  channel             NotificationChannel
  recipient_kind      NotificationRecipientKind
  recipient_email     String?
  message_class       NotificationMessageClass  @default(TRANSACTIONAL)
  workshop_order_id   String?
  workshop_order      WorkshopOrder?            @relation(fields: [tenant_id, workshop_order_id], references: [tenant_id, id], onDelete: Restrict)
  source_entity_type  String?
  source_entity_id    String?
  template_id         String?
  template_version    Int?
  /// AUT-576 language frozen when the message was rendered for enqueue.
  document_locale     DisplayLanguage?
  format_locale       String?           @db.VarChar(8)
  subject             String?
  body                String?
  body_sha256         String?
  body_purged_at      DateTime?
  payload             Json?
  status              NotificationOutboxStatus  @default(PENDING)
  attempts            Int                       @default(0)
  next_attempt_at     DateTime                  @default(now())
  lease_token         String?
  lease_expires_at    DateTime?
  provider            String?
  provider_message_id String?
  accepted_at         DateTime?
  failed_at           DateTime?
  last_error_code     String?
  last_error_message  String?
  suppressed_reason   String?
  sender_name         String?
  reply_to_email      String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@unique([tenant_id, idempotency_key])
  @@index([tenant_id])
  @@index([tenant_id, workshop_order_id, createdAt])
  @@index([tenant_id, status, next_attempt_at])
  @@map("notification_outbox")
}

/// Transactional domain occurrence log (AUT-536). Written in the same transaction as the state change
/// it records. `sequence` gives stable feed ordering; consumers resume with a versioned cursor on
/// `(sequence, id)`, not `occurred_at` alone. Rows are append-only and have no delete API.
model DomainEvent {
  id             String   @id @default(uuid())
  sequence       BigInt   @default(autoincrement())
  event_type     String
  schema_version Int
  tenant_id      String
  tenant         Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  site_id        String
  site           Site     @relation(fields: [tenant_id, site_id], references: [tenant_id, id], onDelete: Restrict)
  entity_id      String
  occurred_at    DateTime
  trace_id       String   @db.Uuid
  occurrence_key String
  payload        Json?
  consumerDeliveries DomainEventConsumerDelivery[]

  @@unique([tenant_id, occurrence_key])
  @@unique([tenant_id, id])
  @@index([tenant_id, sequence])
  @@index([tenant_id, site_id, sequence])
  @@map("domain_events")
}

/// Per-tenant consumer cursor and lease (AUT-544). Progress advances only after a delivery row is
/// committed for the event; a claim prevents two workers from processing the same tenant batch.
model DomainEventConsumerProgress {
  tenant_id        String
  tenant           Tenant   @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  consumer_key     String
  cursor_sequence  BigInt   @default(0)
  cursor_event_id  String?
  claim_token      String?  @db.Uuid
  claim_expires_at DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@id([tenant_id, consumer_key])
  @@map("domain_event_consumer_progress")
}

/// Idempotent effect of one consumer on one domain event (AUT-544). A replay or duplicate worker
/// sees the row and advances the cursor without writing a second outbox notice.
model DomainEventConsumerDelivery {
  tenant_id              String
  tenant                 Tenant     @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  consumer_key           String
  domain_event_id        String
  domain_event           DomainEvent @relation(fields: [tenant_id, domain_event_id], references: [tenant_id, id], onDelete: Restrict)
  outcome                String
  notification_outbox_id String?
  createdAt              DateTime   @default(now())

  @@unique([tenant_id, consumer_key, domain_event_id])
  @@index([tenant_id, consumer_key])
  @@map("domain_event_consumer_deliveries")
}

