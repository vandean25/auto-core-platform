// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Finance Settings & Revenue Groups
// ============================================================================

model RevenueGroup {
  id             Int           @id @default(autoincrement())
  name           String        @unique
  tax_rate       Decimal       @db.Decimal(5, 2)
  account_number String
  is_default     Boolean       @default(false)
  
  catalog_items  CatalogItem[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("revenue_groups")
}

model FinanceSettings {
  id                      Int       @id @default(1)
  fiscal_year_start_month Int       @default(1)
  lock_date               DateTime?
  next_invoice_number     Int       @default(1001)
  invoice_prefix          String    @default("RE-2026-")
  next_sales_order_number Int       @default(1001)
  sales_order_prefix      String    @default("SO-2026-")
  next_workshop_order_number Int    @default(1)
  workshop_order_prefix      String
  
  updatedAt               DateTime  @updatedAt

  @@map("finance_settings")
}

// ============================================================================
// Brands (Master Data)
// ============================================================================

model Brand {
  id                 Int       @id @default(autoincrement())
  name               String    @unique
  isVehicleMake      Boolean   @default(false) @map("is_vehicle_make")
  isPartManufacturer Boolean   @default(false) @map("is_part_manufacturer")
  logoUrl            String?   @map("logo_url")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  vendors      Vendor[]      @relation("VendorBrands")
  catalogItems CatalogItem[]

  @@map("brands")
}

// ============================================================================
// Catalog & Inventory
// ============================================================================

model CatalogItem {
  id               String                 @id @default(uuid())
  sku              String                 @unique
  name             String
  cost_price       Decimal                @db.Decimal(10, 2)
  retail_price     Decimal                @db.Decimal(10, 2)
  unit             String                 @default("pcs")
  specs            Json?
  superseded_by_id String?
  superseded_by    CatalogItem?           @relation("Supersession", fields: [superseded_by_id], references: [id])
  supersedes       CatalogItem[]          @relation("Supersession")
  revenue_group_id Int?
  revenue_group    RevenueGroup?          @relation(fields: [revenue_group_id], references: [id])
  brand_id         Int?                   @map("brand_id")
  brand            Brand?                 @relation(fields: [brand_id], references: [id])
  stocks           InventoryStock[]
  transactions     InventoryTransaction[]
  purchase_order_items PurchaseOrderItem[]
  invoice_items    InvoiceItem[]
  sales_order_items SalesOrderItem[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@map("catalog_items")
}

enum LocationType {
  warehouse
  aisle
  shelf
  bin
  customer_storage
}

model StorageLocation {
  id           String                 @id @default(uuid())
  code         String                 @unique
  name         String
  type         LocationType
  parent_id    String?
  parent       StorageLocation?       @relation("Hierarchy", fields: [parent_id], references: [id])
  children     StorageLocation[]      @relation("Hierarchy")
  stocks       InventoryStock[]
  transactions InventoryTransaction[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deletedAt    DateTime?

  @@map("storage_locations")
}

model InventoryStock {
  id                String          @id @default(uuid())
  catalog_item_id   String
  catalog_item      CatalogItem     @relation(fields: [catalog_item_id], references: [id])
  location_id       String
  location          StorageLocation @relation(fields: [location_id], references: [id])
  quantity_on_hand  Int             @default(0)
  quantity_reserved Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([catalog_item_id, location_id])
  @@map("inventory_stocks")
}

enum TransactionType {
  PURCHASE_RECEIPT
  SALE_ISSUE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL_BALANCE
}

model InventoryTransaction {
  id           String          @id @default(uuid())
  item_id      String
  item         CatalogItem     @relation(fields: [item_id], references: [id])
  location_id  String
  location     StorageLocation @relation(fields: [location_id], references: [id])
  quantity     Decimal         @db.Decimal(10, 3) // Signed: positive = add, negative = remove
  type         TransactionType
  reference_id String?         // Invoice #, Workshop Order #, User ID, etc.
  cost_basis   Decimal?        @db.Decimal(10, 2) // For profit calculation
  createdAt    DateTime        @default(now())

  @@map("inventory_transactions")
  @@index([item_id, location_id])
  @@index([type])
  @@index([createdAt])
}

model Vendor {
  id               String   @id @default(uuid())
  name             String
  email            String
  account_number   String
  supportedBrands  Brand[]  @relation("VendorBrands")

  purchase_orders  PurchaseOrder[]
  purchase_invoices PurchaseInvoice[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@map("vendors")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  COMPLETED
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  vendor_id    String
  vendor       Vendor              @relation(fields: [vendor_id], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  order_number String              @unique
  items        PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String  @id @default(uuid())
  purchase_order_id String
  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  catalog_item_id   String
  catalog_item      CatalogItem   @relation(fields: [catalog_item_id], references: [id])
  
  quantity          Int
  quantity_received Int     @default(0)
  quantity_invoiced Decimal @default(0) @db.Decimal(10, 2)
  unit_cost         Decimal @db.Decimal(10, 2)
  
  purchase_invoice_lines PurchaseInvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("purchase_order_items")
}

enum CustomerType {
  PRIVATE
  COMPANY
}

model Customer {
  id             String       @id @default(uuid())
  type           CustomerType @default(PRIVATE)
  company_name   String?
  first_name     String
  last_name      String
  email          String?      @unique
  phone          String?
  vat_id         String?      // UID-Nummer
  
  address_street String?
  address_city   String?
  address_zip    String?
  address_country String?     @default("AT")
  
  vehicles       Vehicle[]
  invoices       Invoice[]
  sales_orders   SalesOrder[]
  workshop_orders WorkshopOrder[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("customers")
}

model Vehicle {
  id           String    @id @default(uuid())
  make         String
  model        String
  year         Int
  engine_code  String?
  vin          String?   @unique
  plate        String?
  customer_id  String?
  customer     Customer? @relation(fields: [customer_id], references: [id])
  invoices     Invoice[]
  sales_orders SalesOrder[]
  workshop_orders WorkshopOrder[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("vehicles")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  INVOICED
}

model SalesOrder {
  id           String           @id @default(uuid())
  order_number String           @unique // e.g., SO-2026-001
  customer_id  String
  customer     Customer         @relation(fields: [customer_id], references: [id])
  vehicle_id   String?
  vehicle      Vehicle?         @relation(fields: [vehicle_id], references: [id])
  
  status       SalesOrderStatus @default(DRAFT)
  total_amount Decimal          @db.Decimal(10, 2)
  notes        String?
  
  items        SalesOrderItem[]
  invoice      Invoice?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@map("sales_orders")
}

model SalesOrderItem {
  id              String       @id @default(uuid())
  sales_order_id  String
  sales_order     SalesOrder   @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)
  
  catalog_item_id String?
  catalog_item    CatalogItem? @relation(fields: [catalog_item_id], references: [id])
  
  description     String
  quantity        Decimal      @db.Decimal(10, 2)
  unit_price      Decimal      @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2) // quantity * unit_price
  tax_rate        Decimal      @default(20) @db.Decimal(5, 2)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("sales_order_items")
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  ISSUED
  PAID
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FLAT_AMOUNT
}

model Invoice {
  id             String        @id @default(uuid())
  invoice_number String?       @unique // Nullable because it's only generated on FINALIZED
  customer_id    String
  customer       Customer      @relation(fields: [customer_id], references: [id])
  vehicle_id     String?
  vehicle        Vehicle?      @relation(fields: [vehicle_id], references: [id])
  sales_order_id String?       @unique
  sales_order    SalesOrder?   @relation(fields: [sales_order_id], references: [id])
  workshop_order_id String?    @unique
  workshop_order  WorkshopOrder? @relation(fields: [workshop_order_id], references: [id])
  
  status         InvoiceStatus @default(DRAFT)
  date           DateTime      @default(now())
  due_date       DateTime

  global_discount_type  DiscountType?
  global_discount_value Decimal?      @db.Decimal(10, 2)
  
  total_net      Decimal       @db.Decimal(10, 2)
  total_tax      Decimal       @db.Decimal(10, 2)
  total_gross    Decimal       @db.Decimal(10, 2)
  
  notes          String?
  internal_notes String?
  
  items          InvoiceItem[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("invoices")
}

model InvoiceSequence {
  year    Int    @id
  current Int    @default(0)

  @@map("invoice_sequences")
}

model InvoiceItem {
  id              String       @id @default(uuid())
  invoice_id      String
  invoice         Invoice      @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  
  catalog_item_id String?
  catalog_item    CatalogItem? @relation(fields: [catalog_item_id], references: [id])
  
  description        String
  quantity           Decimal      @db.Decimal(10, 2)
  unit_price         Decimal      @db.Decimal(10, 2)
  tax_rate           Decimal      @db.Decimal(5, 2)
  line_discount_type  DiscountType?
  line_discount_value Decimal?      @db.Decimal(10, 2)
  line_total          Decimal?      @db.Decimal(10, 2)
  revenue_group_name String?      // Snapshot for accounting export
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("invoice_items")
  @@index([catalog_item_id])
}

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  PAID
}

model PurchaseInvoice {
  id                    String                @id @default(uuid())
  vendor_id             String
  vendor                Vendor                @relation(fields: [vendor_id], references: [id])
  invoice_number        String?               @unique
  vendor_invoice_number String
  status                PurchaseInvoiceStatus @default(DRAFT)
  invoice_date          DateTime
  due_date              DateTime
  total_amount          Decimal               @db.Decimal(10, 2)
  
  lines                 PurchaseInvoiceLine[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                      String             @id @default(uuid())
  purchase_invoice_id     String
  purchase_invoice        PurchaseInvoice    @relation(fields: [purchase_invoice_id], references: [id], onDelete: Cascade)
  purchase_order_item_id  String?
  purchase_order_item     PurchaseOrderItem? @relation(fields: [purchase_order_item_id], references: [id])
  
  description             String
  quantity                Decimal            @db.Decimal(10, 2)
  unit_price              Decimal            @db.Decimal(10, 2)
  tax_rate                Decimal            @default(20) @db.Decimal(5, 2)
  line_total              Decimal            @db.Decimal(10, 2)

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@map("purchase_invoice_lines")
}

// ============================================================================
// Workshop Intake
// ============================================================================

enum WorkshopOrderStatus {
  SCHEDULED
  INTAKE
  IN_PROGRESS
  COMPLETED
  INVOICED
}

model WorkshopOrder {
  id           String              @id @default(uuid())
  order_number String              @unique
  status       WorkshopOrderStatus @default(INTAKE)

  customer_id  String
  customer     Customer            @relation(fields: [customer_id], references: [id])
  vehicle_id   String
  vehicle      Vehicle             @relation(fields: [vehicle_id], references: [id])

  odometer     Int
  fuel_level   Int                 // 0-100
  reported_issue String?
  notes        String?
  tasks        WorkshopTask[]
  invoice      Invoice?

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@map("workshop_orders")
}

enum WorkshopTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_PARTS
  DONE
}

enum WorkshopLineItemType {
  LABOR
  PART
}

model WorkshopTask {
  id                String             @id @default(uuid())
  workshop_order_id String
  workshop_order    WorkshopOrder      @relation(fields: [workshop_order_id], references: [id], onDelete: Cascade)

  title             String
  status            WorkshopTaskStatus @default(NOT_STARTED)
  mechanic_notes    String?

  line_items        WorkshopTaskLineItem[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@map("workshop_tasks")
}

model WorkshopTaskLineItem {
  id                String               @id @default(uuid())
  workshop_task_id  String
  workshop_task     WorkshopTask         @relation(fields: [workshop_task_id], references: [id], onDelete: Cascade)

  type              WorkshopLineItemType
  // For PART this stores SKU/part number; for LABOR this stores a labor code.
  item_no           String
  description       String
  quantity          Decimal              @db.Decimal(10, 2)
  unit_price        Decimal              @db.Decimal(10, 2)

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("workshop_task_line_items")
}

model LaborOperation {
  id            String        @id @default(uuid())
  code          String        @unique
  description   String
  standard_aw   Decimal       @db.Decimal(10, 2)
  hourly_rate   Decimal       @db.Decimal(10, 2)
  fitments      LaborFitment[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("labor_operations")
  @@index([description])
  @@index([code, description])
}

model LaborFitment {
  id                 String         @id @default(uuid())
  labor_operation_id String
  labor_operation    LaborOperation @relation(fields: [labor_operation_id], references: [id], onDelete: Cascade)
  make               String
  model              String
  year_from          Int?
  year_to            Int?
  engine_code        String?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("labor_fitments")
  @@index([labor_operation_id])
  @@index([make, model, year_from, year_to, engine_code])
}

model MasterPart {
  id                   String          @id @default(uuid())
  supplier_part_number String          @unique
  oem_number           String?
  description          String
  brand                String
  fitments             PartFitment[]
  local_inventory      LocalInventory?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("master_parts")
  @@index([description])
  @@index([supplier_part_number, oem_number, description])
}

model PartFitment {
  id             String     @id @default(uuid())
  master_part_id String
  master_part    MasterPart @relation(fields: [master_part_id], references: [id], onDelete: Cascade)
  make           String
  model          String
  year_from      Int?
  year_to        Int?
  engine_code    String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("part_fitments")
  @@index([master_part_id])
  @@index([make, model, year_from, year_to, engine_code])
}

model LocalInventory {
  id               String     @id @default(uuid())
  master_part_id   String     @unique
  master_part      MasterPart @relation(fields: [master_part_id], references: [id], onDelete: Cascade)
  quantity_on_hand Int        @default(0)
  bin_location     String?
  cost_price       Decimal    @db.Decimal(10, 2)
  retail_price     Decimal    @db.Decimal(10, 2)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("local_inventories")
  @@index([quantity_on_hand])
}
