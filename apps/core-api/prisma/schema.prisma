enum TransactionType {
  PURCHASE_RECEIPT
  SALE_ISSUE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL_BALANCE
  WORKSHOP_CONSUMPTION
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
}

enum AuditActorType {
  USER
  SYSTEM
  MIGRATION
}

model InventoryTransaction {
  id                   String            @id @default(uuid())
  seq                  BigInt            @default(autoincrement())
  tenant_id            String
  tenant               Tenant            @relation(fields: [tenant_id], references: [id])
  site_id              String
  item_id              String
  item                 CatalogItem       @relation(fields: [item_id], references: [id])
  location_id          String
  location             StorageLocation   @relation(fields: [tenant_id, site_id, location_id], references: [tenant_id, site_id, id])
  quantity             Decimal           @db.Decimal(10, 3) // Signed: positive = add, negative = remove
  type                 TransactionType
  reference_id         String? // Invoice #, Workshop Order #, User ID, etc.
  cost_basis           Decimal?          @db.Decimal(10, 2) // For profit calculation
  parts_reservation_id String?
  parts_reservation    PartsReservation? @relation(fields: [parts_reservation_id], references: [id], onDelete: Restrict)
  movement_group_id    String? // Pairs transfer ledger movements (ship/receive/return)
  stock_transfer_id    String?
  stock_transfer       StockTransfer?    @relation(fields: [tenant_id, stock_transfer_id], references: [tenant_id, id])
  createdAt            DateTime          @default(now())

  @@unique([tenant_id, seq])
  @@index([tenant_id])
  @@index([tenant_id, site_id])
  @@index([item_id, location_id])
  @@index([type])
  @@index([createdAt])
  @@index([seq])
  @@index([movement_group_id])
  @@map("inventory_transactions")
}

// ============================================================================
// Same-GmbH Stock Transfers (ADR-0022)
// ============================================================================

enum StockTransferStatus {
  REQUESTED
  APPROVED
  SHIPPED
  COMPLETED
  REJECTED
  CANCELLED
}

enum StockTransferCommandAction {
  RECEIVE
  RETURN
}

model StockTransfer {
  id                   String                 @id @default(uuid())
  tenant_id            String
  tenant               Tenant                 @relation(fields: [tenant_id], references: [id])
  transfer_number      String
  from_site_id         String
  from_site            Site                   @relation("StockTransferFromSite", fields: [tenant_id, from_site_id], references: [tenant_id, id])
  to_site_id           String
  to_site              Site                   @relation("StockTransferToSite", fields: [tenant_id, to_site_id], references: [tenant_id, id])
  status               StockTransferStatus    @default(REQUESTED)
  version              Int                    @default(1)
  requested_by_user_id String
  requestedBy          User                   @relation("StockTransferRequestedBy", fields: [requested_by_user_id], references: [id])
  approved_by_user_id  String?
  approvedBy           User?                  @relation("StockTransferApprovedBy", fields: [approved_by_user_id], references: [id])
  shipped_by_user_id   String?
  shippedBy            User?                  @relation("StockTransferShippedBy", fields: [shipped_by_user_id], references: [id])
  received_by_user_id  String?
  receivedBy           User?                  @relation("StockTransferReceivedBy", fields: [received_by_user_id], references: [id])
  reject_reason        String?
  cancel_reason        String?
  lines                StockTransferLine[]
  commands             StockTransferCommand[]
  ledgerMovements      InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenant_id, id])
  @@unique([tenant_id, id, from_site_id, to_site_id])
  @@unique([tenant_id, transfer_number])
  @@index([tenant_id, from_site_id])
  @@index([tenant_id, to_site_id])
  @@map("stock_transfers")
}

model StockTransferLine {
  id                 String           @id @default(uuid())
  tenant_id          String
  tenant             Tenant           @relation(fields: [tenant_id], references: [id])
  transfer_id        String
  from_site_id       String
  to_site_id         String
  transfer           StockTransfer    @relation(fields: [tenant_id, transfer_id, from_site_id, to_site_id], references: [tenant_id, id, from_site_id, to_site_id], onDelete: Cascade)
  catalog_item_id    String
  catalog_item       CatalogItem      @relation(fields: [catalog_item_id], references: [id])
  source_location_id String?
  source_location    StorageLocation? @relation("StockTransferSourceLocation", fields: [tenant_id, from_site_id, source_location_id], references: [tenant_id, site_id, id])
  dest_location_id   String?
  dest_location      StorageLocation? @relation("StockTransferDestLocation", fields: [tenant_id, to_site_id, dest_location_id], references: [tenant_id, site_id, id])
