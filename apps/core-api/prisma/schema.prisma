// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Multi-tenant Foundation
// ============================================================================

enum TenantPlan {
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum TenantMemberRole {
  OWNER
  ADMIN
  TECH
  SALES
}

enum PlatformAdminRole {
  SUPER_ADMIN
}

model Tenant {
  id         String     @id @default(uuid())
  name       String
  slug       String     @unique
  plan       TenantPlan @default(STANDARD)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  is_active  Boolean    @default(true)

  revenueGroups        RevenueGroup[]
  financeSettings      FinanceSettings?
  voiceTranslationSettings VoiceTranslationSettings?
  brands               Brand[]
  catalogItems         CatalogItem[]
  storageLocations     StorageLocation[]
  inventoryStocks      InventoryStock[]
  inventoryTransactions InventoryTransaction[]
  vendors              Vendor[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  customers            Customer[]
  vehicles             Vehicle[]
  vehiclePurchases     VehiclePurchase[]
  vehicleSales         VehicleSale[]
  vehicleLedgerEntries VehicleLedgerEntry[]
  salesOrders          SalesOrder[]
  salesOrderItems      SalesOrderItem[]
  invoices             Invoice[]
  invoiceSequences     InvoiceSequence[]
  invoiceItems         InvoiceItem[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  inspectionTemplates  InspectionTemplate[]
  inspectionTemplateItems InspectionTemplateItem[]
  workshopInspections  WorkshopInspection[]
  workshopInspectionItems WorkshopInspectionItem[]
  workshopMedia        WorkshopMedia[]
  workshopVoiceNoteDrafts WorkshopVoiceNoteDraft[]
  voiceNoteRateLimits  VoiceNoteRateLimit[]
  workshopOrders       WorkshopOrder[]
  workshopTasks        WorkshopTask[]
  workshopTaskLineItems WorkshopTaskLineItem[]
  employees            Employee[]
  bays                 Bay[]
  workshopSettings     WorkshopSettings?
  workshopOpeningHours WorkshopOpeningHour[]
  workshopHolidays     WorkshopHoliday[]
  employeeLeaveBalances EmployeeLeaveBalance[]
  leaveRequests        LeaveRequest[]
  attendanceEvents     AttendanceEvent[]
  employeeWorkSchedules EmployeeWorkSchedule[]
  employeeWorkScheduleDays EmployeeWorkScheduleDay[]
  laborCategories      LaborCategory[]
  laborOperations      LaborOperation[]
  laborEntries         LaborEntry[]
  catalogProviderSettings CatalogProviderSettings?
  catalogOemConcerns   CatalogOemConcern[]
  catalogOemConcernMakes CatalogOemConcernMake[]
  vehicleMakeAliases   VehicleMakeAlias[]
  auditLogs            AuditLog[]
  memberships          TenantMember[]
  activeUsers          User[]         @relation("UserActiveTenant")

  @@map("tenants")
}

model User {
  id               String         @id @default(uuid())
  firebaseUid      String         @unique @map("firebase_uid")
  email            String         @unique
  firstName        String?        @map("first_name")
  lastName         String?        @map("last_name")
  active_tenant_id String?
  activeTenant     Tenant?        @relation("UserActiveTenant", fields: [active_tenant_id], references: [id])
  memberships      TenantMember[]
  platformAdmin    PlatformAdmin?
  employees        Employee[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([active_tenant_id])
  @@map("users")
}

model TenantMember {
  id        String           @id @default(uuid())
  tenant_id String
  tenant    Tenant           @relation(fields: [tenant_id], references: [id])
  user_id   String
  user      User             @relation(fields: [user_id], references: [id])
  role      TenantMemberRole
  is_active Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([tenant_id])
  @@index([user_id])
  @@unique([tenant_id, user_id])
  @@map("tenant_members")
}

model PlatformAdmin {
  id        String            @id @default(uuid())
  user_id   String            @unique
  user      User              @relation(fields: [user_id], references: [id])
  role      PlatformAdminRole @default(SUPER_ADMIN)
  is_active Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("platform_admins")
}

// ============================================================================
// Finance Settings & Revenue Groups
// ============================================================================

model RevenueGroup {
  id             Int           @id @default(autoincrement())
  tenant_id      String
  tenant         Tenant        @relation(fields: [tenant_id], references: [id])
  name           String
  tax_rate       Decimal       @db.Decimal(5, 2)
  account_number String
  is_default     Boolean       @default(false)
  
  catalog_items  CatalogItem[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, name]) // tenant-scoped
  @@map("revenue_groups")
}

model FinanceSettings {
  id                      String    @id @default(uuid())
  tenant_id               String
  tenant                  Tenant    @relation(fields: [tenant_id], references: [id])
  fiscal_year_start_month Int       @default(1)
  lock_date               DateTime?
  next_invoice_number     Int       @default(1001)
  invoice_prefix          String    @default("RE-2026-")
  next_sales_order_number Int       @default(1001)
  sales_order_prefix      String    @default("SO-2026-")
  next_workshop_order_number Int    @default(1)
  workshop_order_prefix      String
  next_vehicle_purchase_number Int    @default(1)
  vehicle_purchase_prefix      String @default("VP-2026-")
  next_vehicle_sale_number     Int    @default(1)
  vehicle_sale_prefix          String @default("VS-2026-")

  updatedAt               DateTime  @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id]) // tenant-scoped
  @@map("finance_settings")
}

model VoiceTranslationSettings {
  id                              String   @id @default(uuid())
  tenant_id                       String
  tenant                          Tenant   @relation(fields: [tenant_id], references: [id])
  target_language_code            String   @default("de")
  google_project_id               String?
  google_location                 String   @default("global")
  google_service_account_encrypted String?
  updatedAt                       DateTime @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id])
  @@map("voice_translation_settings")
}

// ============================================================================
// Brands (Master Data)
// ============================================================================

model Brand {
  id                 Int       @id @default(autoincrement())
  tenant_id          String
  tenant             Tenant    @relation(fields: [tenant_id], references: [id])
  name               String
  normalized_name    String    @map("normalized_name")
  isVehicleMake      Boolean   @default(false) @map("is_vehicle_make")
  isPartManufacturer Boolean   @default(false) @map("is_part_manufacturer")
  logoUrl            String?   @map("logo_url")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  vendors      Vendor[]      @relation("VendorBrands")
  catalogItems CatalogItem[]
  vehiclesAsMake Vehicle[] @relation("VehicleMakeBrand")
  vehicleMakeAliases VehicleMakeAlias[]
  catalogOemConcernMakes CatalogOemConcernMake[]

  @@index([tenant_id])
  @@unique([tenant_id, name]) // tenant-scoped
  @@unique([tenant_id, normalized_name]) // tenant-scoped canonical name
  @@map("brands")
}

enum CatalogOemConcernCode {
  BMW
  MERCEDES
  STELLANTIS
}

model CatalogProviderSettings {
  id                                   String         @id @default(uuid())
  tenant_id                            String
  tenant                               Tenant         @relation(fields: [tenant_id], references: [id])
  default_identity_adapter_id          String?        @map("default_identity_adapter_id")
  default_parts_aftermarket_adapter_id String?        @map("default_parts_aftermarket_adapter_id")
  default_labor_aftermarket_adapter_id String?        @map("default_labor_aftermarket_adapter_id")
  default_labor_category_id            String?        @db.Uuid @map("default_labor_category_id")
  defaultLaborCategory                 LaborCategory? @relation(fields: [default_labor_category_id], references: [id], onDelete: Restrict)
  aw_minutes                           Int            @default(6) @map("aw_minutes")
  identity_credentials_secret_ref      String?        @map("identity_credentials_secret_ref")
  parts_aftermarket_credentials_secret_ref String?    @map("parts_aftermarket_credentials_secret_ref")
  labor_aftermarket_credentials_secret_ref String?    @map("labor_aftermarket_credentials_secret_ref")
  updatedAt                            DateTime       @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id])
  @@map("catalog_provider_settings")
}

model CatalogOemConcern {
  id                             String                @id @default(uuid())
  tenant_id                      String
  tenant                         Tenant                @relation(fields: [tenant_id], references: [id])
  code                           CatalogOemConcernCode
  parts_adapter_id               String?               @map("parts_adapter_id")
  labor_adapter_id               String?               @map("labor_adapter_id")
  parts_credentials_secret_ref   String?               @map("parts_credentials_secret_ref")
  labor_credentials_secret_ref   String?               @map("labor_credentials_secret_ref")
  memberMakes                    CatalogOemConcernMake[]
  createdAt                      DateTime              @default(now())
  updatedAt                      DateTime              @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, code])
  @@unique([tenant_id, id])
  @@map("catalog_oem_concerns")
}

model CatalogOemConcernMake {
  id          String            @id @default(uuid())
  tenant_id   String
  tenant      Tenant            @relation(fields: [tenant_id], references: [id])
  concern_id  String            @map("concern_id")
  concern     CatalogOemConcern @relation(fields: [tenant_id, concern_id], references: [tenant_id, id], onDelete: Cascade)
  brand_id    Int               @map("brand_id")
  brand       Brand             @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  createdAt   DateTime          @default(now())

  @@index([tenant_id])
  @@unique([tenant_id, brand_id])
  @@unique([tenant_id, id])
  @@map("catalog_oem_concern_makes")
}

model VehicleMakeAlias {
  id               String   @id @default(uuid())
  tenant_id        String
  tenant           Tenant   @relation(fields: [tenant_id], references: [id])
  alias_normalized String   @map("alias_normalized")
  brand_id         Int      @map("brand_id")
  brand            Brand    @relation(fields: [brand_id], references: [id], onDelete: Restrict)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, alias_normalized])
  @@unique([tenant_id, id])
  @@map("vehicle_make_aliases")
}

// ============================================================================
// Catalog & Inventory
// ============================================================================

model CatalogItem {
  id                  String                 @id @default(uuid())
  tenant_id           String
  tenant              Tenant                 @relation(fields: [tenant_id], references: [id])
  sku                 String
  name                String
  cost_price          Decimal?               @db.Decimal(10, 2)
  retail_price        Decimal                @db.Decimal(10, 2)
  unit                String                 @default("pcs")
  source_system       String?
  external_article_id String?
  ean                 String?
  oem_numbers         Json?
  specs               Json?
  superseded_by_id    String?
  superseded_by       CatalogItem?           @relation("Supersession", fields: [superseded_by_id], references: [id])
  supersedes          CatalogItem[]          @relation("Supersession")
  revenue_group_id    Int?
  revenue_group       RevenueGroup?          @relation(fields: [revenue_group_id], references: [id])
  brand_id            Int?                   @map("brand_id")
  brand               Brand?                 @relation(fields: [brand_id], references: [id])
  stocks              InventoryStock[]
  transactions        InventoryTransaction[]
  purchase_order_items PurchaseOrderItem[]
  invoice_items       InvoiceItem[]
  sales_order_items   SalesOrderItem[]
  workshop_task_line_items WorkshopTaskLineItem[]
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, sku]) // tenant-scoped
  @@map("catalog_items")
}

enum LocationType {
  warehouse
  aisle
  shelf
  bin
  customer_storage
  staging_tote
  vehicle_lot
}

model StorageLocation {
  id           String                 @id @default(uuid())
  tenant_id    String
  tenant       Tenant                 @relation(fields: [tenant_id], references: [id])
  code         String
  name         String
  type         LocationType
  parent_id    String?
  parent       StorageLocation?       @relation("Hierarchy", fields: [parent_id], references: [id])
  children     StorageLocation[]      @relation("Hierarchy")
  stocks       InventoryStock[]
  transactions InventoryTransaction[]
  stagingWorkshopOrders WorkshopOrder[] @relation("WorkshopOrderStagingLocation")
  parkedVehicles        Vehicle[]       @relation("VehicleLot")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deletedAt    DateTime?

  @@index([tenant_id])
  @@unique([tenant_id, code]) // tenant-scoped
  @@map("storage_locations")
}

model InventoryStock {
  id                String          @id @default(uuid())
  tenant_id         String
  tenant            Tenant          @relation(fields: [tenant_id], references: [id])
  catalog_item_id   String
  catalog_item      CatalogItem     @relation(fields: [catalog_item_id], references: [id])
  location_id       String
  location          StorageLocation @relation(fields: [location_id], references: [id])
  quantity_on_hand  Int             @default(0)
  quantity_reserved Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, catalog_item_id, location_id]) // tenant-scoped
  @@map("inventory_stocks")
}

enum TransactionType {
  PURCHASE_RECEIPT
  SALE_ISSUE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL_BALANCE
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
}

enum AuditActorType {
  USER
  SYSTEM
  MIGRATION
}

model InventoryTransaction {
  id           String          @id @default(uuid())
  tenant_id    String
  tenant       Tenant          @relation(fields: [tenant_id], references: [id])
  item_id      String
  item         CatalogItem     @relation(fields: [item_id], references: [id])
  location_id  String
  location     StorageLocation @relation(fields: [location_id], references: [id])
  quantity     Decimal         @db.Decimal(10, 3) // Signed: positive = add, negative = remove
  type         TransactionType
  reference_id String?         // Invoice #, Workshop Order #, User ID, etc.
  cost_basis   Decimal?        @db.Decimal(10, 2) // For profit calculation
  createdAt    DateTime        @default(now())

  @@map("inventory_transactions")
  @@index([tenant_id])
  @@index([item_id, location_id])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id                String         @id @default(uuid())
  tenant_id         String
  tenant            Tenant         @relation(fields: [tenant_id], references: [id])
  entity_type       String
  entity_id         String
  action            AuditLogAction
  actor_user_id     String?
  actor_email       String?
  actor_role        String?
  actor_type        AuditActorType
  request_id        String?
  source            String?
  ip_address        String?
  user_agent        String?
  before            Json?
  after             Json?
  diff              Json?
  changed_fields    Json?
  redacted_fields   Json?
  occurred_at       DateTime       @default(now())

  @@index([tenant_id, occurred_at])
  @@index([tenant_id, entity_type, entity_id, occurred_at])
  @@index([request_id])
  @@map("audit_logs")
}

model Vendor {
  id               String   @id @default(uuid())
  tenant_id        String
  tenant           Tenant   @relation(fields: [tenant_id], references: [id])
  name             String
  email            String
  account_number   String
  supportedBrands  Brand[]  @relation("VendorBrands")

  purchase_orders  PurchaseOrder[]
  purchase_invoices PurchaseInvoice[]
  vehicle_purchases VehiclePurchase[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenant_id])
  @@map("vendors")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  COMPLETED
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenant_id    String
  tenant       Tenant              @relation(fields: [tenant_id], references: [id])
  vendor_id    String
  vendor       Vendor              @relation(fields: [vendor_id], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  order_number String
  items        PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, order_number]) // tenant-scoped
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String  @id @default(uuid())
  tenant_id         String
  tenant            Tenant  @relation(fields: [tenant_id], references: [id])
  purchase_order_id String
  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  catalog_item_id   String
  catalog_item      CatalogItem   @relation(fields: [catalog_item_id], references: [id])
  
  quantity          Int
  quantity_received Int     @default(0)
  quantity_invoiced Decimal @default(0) @db.Decimal(10, 2)
  unit_cost         Decimal @db.Decimal(10, 2)
  
  purchase_invoice_lines PurchaseInvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenant_id])
  @@map("purchase_order_items")
}

enum CustomerType {
  PRIVATE
  COMPANY
}

model Customer {
  id             String       @id @default(uuid())
  tenant_id      String
  tenant         Tenant       @relation(fields: [tenant_id], references: [id])
  type           CustomerType @default(PRIVATE)
  company_name   String?
  first_name     String
  last_name      String
  email          String?
  phone          String?
  vat_id         String?      // UID-Nummer
  
  address_street String?
  address_city   String?
  address_zip    String?
  address_country String?     @default("AT")
  
  vehicles       Vehicle[]
  reserved_stock_vehicles Vehicle[] @relation("VehicleStockReservation")
  invoices       Invoice[]
  sales_orders   SalesOrder[]
  workshop_orders WorkshopOrder[]
  vehicle_purchases VehiclePurchase[] @relation("VehiclePurchaseSeller")
  vehicle_sales     VehicleSale[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, email]) // tenant-scoped
  @@map("customers")
}

model Vehicle {
  id           String    @id @default(uuid())
  tenant_id    String    
  tenant       Tenant    @relation(fields: [tenant_id], references: [id])
  make         String
  model        String
  year         Int
  engine_code  String?
  vin          String?
  plate        String?
  make_brand_id Int?     @map("make_brand_id")
  makeBrand    Brand?    @relation("VehicleMakeBrand", fields: [make_brand_id], references: [id], onDelete: SetNull)
  hsn          String?
  tsn          String?
  identity_keys Json?    @map("identity_keys")
  identity_input_fingerprint String? @map("identity_input_fingerprint")
  identity_resolved_at DateTime? @map("identity_resolved_at")
  identity_resolution_generation String? @map("identity_resolution_generation")
  identity_resolution_token String? @map("identity_resolution_token")
  fuel_type    String?   @map("fuel_type")
  power_kw     Int?      @map("power_kw")
  customer_id  String?
  customer     Customer? @relation(fields: [customer_id], references: [id])
  inventory_role VehicleInventoryRole @default(CUSTOMER)
  stock_status   VehicleStockStatus?
  tax_scheme     VehicleTaxScheme?
  mileage        Int?
  color          String?
  key_number     String?
  registration_certificate_no String?
  location_id    String?
  location       StorageLocation? @relation("VehicleLot", fields: [location_id], references: [id], onDelete: SetNull)
  reserved_for_customer_id String?
  reserved_for_customer    Customer? @relation("VehicleStockReservation", fields: [reserved_for_customer_id], references: [id], onDelete: SetNull)
  invoices     Invoice[]
  sales_orders SalesOrder[]
  workshop_orders WorkshopOrder[]
  purchases    VehiclePurchase[]
  sales        VehicleSale[]
  ledger_entries VehicleLedgerEntry[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenant_id])
  @@index([tenant_id, inventory_role, stock_status])
  @@index([tenant_id, hsn, tsn])
  @@index([make_brand_id])
  @@index([tenant_id, vin])
  @@map("vehicles")
}

enum VehicleInventoryRole {
  CUSTOMER
  USED
  NEW
  DEMO
}

enum VehicleStockStatus {
  ON_ORDER
  IN_STOCK
  RESERVED
  IN_PREP
  SOLD
}

enum VehicleTaxScheme {
  MARGIN
  STANDARD
}

enum VehiclePurchaseSellerType {
  VENDOR
  CUSTOMER
}

enum VehicleAcquisitionKind {
  DIRECT
  TRADE_IN
}

enum VehiclePurchaseStatus {
  DRAFT
  RECEIVED
  CANCELLED
}

enum VehicleSaleStatus {
  DRAFT
  INVOICED
  CANCELLED
}

enum VehicleLedgerEntryType {
  PURCHASE
  WORKSHOP_COST
  ADJUSTMENT
  SALE
}

enum InvoiceTaxMode {
  STANDARD
  MARGIN_SCHEME
}

enum WorkshopOrderPurpose {
  CUSTOMER_REPAIR
  STOCK_PREP
}

model VehiclePurchase {
  id               String                     @id @default(uuid())
  tenant_id        String
  tenant           Tenant                     @relation(fields: [tenant_id], references: [id])
  purchase_number  String
  status           VehiclePurchaseStatus      @default(DRAFT)
  seller_type      VehiclePurchaseSellerType
  vendor_id        String?
  vendor           Vendor?                    @relation(fields: [vendor_id], references: [id])
  customer_id      String?
  customer         Customer?                  @relation("VehiclePurchaseSeller", fields: [customer_id], references: [id])
  acquisition_kind VehicleAcquisitionKind     @default(DIRECT)
  vehicle_id       String?
  vehicle          Vehicle?                   @relation(fields: [vehicle_id], references: [id])
  vin              String?
  make             String
  model            String
  year             Int
  engine_code      String?
  plate            String?
  color            String?
  mileage          Int?
  key_number       String?
  registration_certificate_no String?
  purchase_price   Decimal                    @db.Decimal(12, 2)
  location_id      String?
  received_at      DateTime?
  ledger_entries   VehicleLedgerEntry[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, purchase_number])
  @@map("vehicle_purchases")
}

model VehicleSale {
  id                   String            @id @default(uuid())
  tenant_id            String
  tenant               Tenant            @relation(fields: [tenant_id], references: [id])
  sale_number          String
  status               VehicleSaleStatus @default(DRAFT)
  vehicle_id           String
  vehicle              Vehicle           @relation(fields: [vehicle_id], references: [id])
  customer_id          String
  customer             Customer          @relation(fields: [customer_id], references: [id])
  sale_price           Decimal           @db.Decimal(12, 2)
  cost_basis_snapshot  Decimal?          @db.Decimal(12, 2)
  margin_vat_snapshot  Decimal?          @db.Decimal(12, 2)
  trade_in_purchase_id String?
  invoice              Invoice?
  ledger_entries       VehicleLedgerEntry[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, id])
  @@unique([tenant_id, sale_number])
  @@map("vehicle_sales")
}

model VehicleLedgerEntry {
  id                  String                  @id @default(uuid())
  tenant_id           String
  tenant              Tenant                  @relation(fields: [tenant_id], references: [id])
  vehicle_id          String
  vehicle             Vehicle                 @relation(fields: [vehicle_id], references: [id])
  entry_type          VehicleLedgerEntryType
  amount              Decimal                 @db.Decimal(12, 2)
  posting_date        DateTime
  vehicle_purchase_id String?
  vehicle_purchase    VehiclePurchase?        @relation(fields: [vehicle_purchase_id], references: [id])
  vehicle_sale_id     String?
  vehicle_sale        VehicleSale?            @relation(fields: [vehicle_sale_id], references: [id])
  workshop_order_id   String?
  workshop_order      WorkshopOrder?          @relation(fields: [workshop_order_id], references: [id])
  notes               String?
  createdAt           DateTime                @default(now())

  @@index([tenant_id])
  @@index([tenant_id, vehicle_id])
