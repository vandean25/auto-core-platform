  WAITING_CUSTOMER
  AUTO_SHIFT_CLOSE
  SWITCHED_TO_HIGHER_PRIORITY
  OTHER
}

enum WorkshopLineItemType {
  LABOR
  PART
}

enum WorkshopPartLineExecutionStatus {
  PENDING_PICK
  STAGED
  CONSUMED
  CANCELLED
}

enum InspectionTemplateItemResponseType {
  PASS_FAIL
  NUMERIC
  TEXT
}

enum WorkshopInspectionSeverity {
  OK
  ADVISORY
  REQUIRED
}

enum WorkshopMediaUrlStrategy {
  SIGNED
  PUBLIC
}

model WorkshopTask {
  id                String             @id @default(uuid())
  tenant_id         String
  tenant            Tenant             @relation(fields: [tenant_id], references: [id])
  workshop_order_id String
  workshop_order    WorkshopOrder      @relation(fields: [tenant_id, workshop_order_id], references: [tenant_id, id], onDelete: Cascade)

  title             String
  status            WorkshopTaskStatus @default(NOT_STARTED)
  mechanic_notes    String?

  // Task-level assignments override order-level assignments independently when set.
  // Mechanic precedence: task.mechanic_id > order.mechanic_id.
  // Bay precedence: task.bay_id > order.bay_id.
  // See ADR-0014 §2.2 for full queue-visibility rules.
  mechanic_id       String?
  mechanic          Employee?          @relation("WorkshopTaskMechanic", fields: [tenant_id, mechanic_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Cascade)
  bay_id            String?
  bay               Bay?               @relation("WorkshopTaskBay", fields: [tenant_id, bay_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Cascade)

  // Scheduling and queue ordering
  scheduled_date    DateTime?          @db.Date
  sequence          Int                @default(0)

  inspections       WorkshopInspection[]
  line_items        WorkshopTaskLineItem[]
  labor_entries     LaborEntry[]
  media             WorkshopMedia[]
  voice_note_drafts WorkshopVoiceNoteDraft[]
  line_items_version Int               @default(0)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@index([tenant_id, mechanic_id], map: "idx_workshop_tasks_tenant_id_mechanic_id")
  @@index([tenant_id, bay_id], map: "idx_workshop_tasks_tenant_id_bay_id")
  @@index([scheduled_date], map: "idx_workshop_tasks_scheduled_date")
  @@map("workshop_tasks")
}

