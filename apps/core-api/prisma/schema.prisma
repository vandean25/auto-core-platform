// ============================================================================
// Garantie / Kulanz claim file on a workshop order (AUT-464)
// Internal record only: the claim is filed with the OEM outside this system.
// ============================================================================

enum WarrantyClaimType {
  GARANTIE
  KULANZ
  GEWAEHRLEISTUNG
}

enum WarrantyClaimStatus {
  DRAFT
  SUBMITTED_EXTERNALLY
  APPROVED
  REJECTED
  CLOSED
}

model WarrantyClaim {
  id                 String              @id @default(uuid())
  tenant_id          String
  tenant             Tenant              @relation(fields: [tenant_id], references: [id])
  workshop_order_id  String
  workshop_order     WorkshopOrder       @relation(fields: [tenant_id, workshop_order_id], references: [tenant_id, id], onDelete: Restrict, onUpdate: Cascade)
  type               WarrantyClaimType
  status             WarrantyClaimStatus @default(DRAFT)
  complaint          String?
  cause_correction   String?
  /// Claimed amount in EUR, net of VAT.
  claimed_amount_net Decimal?            @db.Decimal(12, 2)
  /// Claim reference at the OEM, entered by the advisor. Free text.
  external_reference String?
  decision_date      DateTime?           @db.Date
  decision_note      String?
  submitted_at       DateTime?
  closed_at          DateTime?
  lines              WarrantyClaimLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@index([tenant_id, workshop_order_id, status])
  @@map("warranty_claims")
}

model WarrantyClaimLine {
  id                         String               @id @default(uuid())
  tenant_id                  String
  tenant                     Tenant               @relation(fields: [tenant_id], references: [id])
  warranty_claim_id          String
  warranty_claim             WarrantyClaim        @relation(fields: [tenant_id, warranty_claim_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: Cascade)
  workshop_task_line_item_id String
  workshop_task_line_item    WorkshopTaskLineItem @relation(fields: [workshop_task_line_item_id], references: [id], onDelete: Restrict, onUpdate: Cascade)

  // Snapshot of the order line taken when it was attached to the claim.
  line_type   WorkshopLineItemType
  item_no     String
  description String
  quantity    Decimal              @db.Decimal(10, 3)
  unit_price  Decimal              @db.Decimal(10, 2)
  net_amount  Decimal              @db.Decimal(18, 2)

  createdAt DateTime @default(now())

  @@unique([tenant_id, warranty_claim_id, workshop_task_line_item_id], map: "warranty_claim_lines_claim_item_key")
  @@index([tenant_id])
  @@index([tenant_id, workshop_task_line_item_id])
  // The foreign key is checked on every delete of a workshop line; this index keeps that check off a full scan.
  @@index([workshop_task_line_item_id])
  @@map("warranty_claim_lines")
}
