// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Multi-tenant Foundation
// ============================================================================

enum TenantPlan {
  STANDARD
  PREMIUM
  ENTERPRISE
}

model Tenant {
  id         String     @id @default(uuid())
  name       String
  slug       String     @unique
  plan       TenantPlan @default(STANDARD)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  is_active  Boolean    @default(true)

  revenueGroups        RevenueGroup[]
  financeSettings      FinanceSettings?
  brands               Brand[]
  catalogItems         CatalogItem[]
  storageLocations     StorageLocation[]
  inventoryStocks      InventoryStock[]
  inventoryTransactions InventoryTransaction[]
  vendors              Vendor[]
  purchaseOrders       PurchaseOrder[]
  purchaseOrderItems   PurchaseOrderItem[]
  customers            Customer[]
  vehicles             Vehicle[]
  salesOrders          SalesOrder[]
  salesOrderItems      SalesOrderItem[]
  invoices             Invoice[]
  invoiceSequences     InvoiceSequence[]
  invoiceItems         InvoiceItem[]
  purchaseInvoices     PurchaseInvoice[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  workshopOrders       WorkshopOrder[]
  workshopTasks        WorkshopTask[]
  workshopTaskLineItems WorkshopTaskLineItem[]
  employees            Employee[]
  bays                 Bay[]
  laborCategories      LaborCategory[]
  laborOperations      LaborOperation[]

  @@map("tenants")
}

// ============================================================================
// Finance Settings & Revenue Groups
// ============================================================================

model RevenueGroup {
  id             Int           @id @default(autoincrement())
  tenant_id      String
  tenant         Tenant        @relation(fields: [tenant_id], references: [id])
  name           String
  tax_rate       Decimal       @db.Decimal(5, 2)
  account_number String
  is_default     Boolean       @default(false)
  
  catalog_items  CatalogItem[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, name]) // tenant-scoped
  @@map("revenue_groups")
}

model FinanceSettings {
  id                      String    @id @default(uuid())
  tenant_id               String
  tenant                  Tenant    @relation(fields: [tenant_id], references: [id])
  fiscal_year_start_month Int       @default(1)
  lock_date               DateTime?
  next_invoice_number     Int       @default(1001)
  invoice_prefix          String    @default("RE-2026-")
  next_sales_order_number Int       @default(1001)
  sales_order_prefix      String    @default("SO-2026-")
  next_workshop_order_number Int    @default(1)
  workshop_order_prefix      String
  
  updatedAt               DateTime  @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id]) // tenant-scoped
  @@map("finance_settings")
}

// ============================================================================
// Brands (Master Data)
// ============================================================================

model Brand {
  id                 Int       @id @default(autoincrement())
  tenant_id          String
  tenant             Tenant    @relation(fields: [tenant_id], references: [id])
  name               String
  isVehicleMake      Boolean   @default(false) @map("is_vehicle_make")
  isPartManufacturer Boolean   @default(false) @map("is_part_manufacturer")
  logoUrl            String?   @map("logo_url")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  vendors      Vendor[]      @relation("VendorBrands")
  catalogItems CatalogItem[]

  @@index([tenant_id])
  @@unique([tenant_id, name]) // tenant-scoped
  @@map("brands")
}

// ============================================================================
// Catalog & Inventory
// ============================================================================

model CatalogItem {
  id               String                 @id @default(uuid())
  tenant_id        String
  tenant           Tenant                 @relation(fields: [tenant_id], references: [id])
  sku              String
  name             String
  cost_price       Decimal                @db.Decimal(10, 2)
  retail_price     Decimal                @db.Decimal(10, 2)
  unit             String                 @default("pcs")
  specs            Json?
  superseded_by_id String?
  superseded_by    CatalogItem?           @relation("Supersession", fields: [superseded_by_id], references: [id])
  supersedes       CatalogItem[]          @relation("Supersession")
  revenue_group_id Int?
  revenue_group    RevenueGroup?          @relation(fields: [revenue_group_id], references: [id])
  brand_id         Int?                   @map("brand_id")
  brand            Brand?                 @relation(fields: [brand_id], references: [id])
  stocks           InventoryStock[]
  transactions     InventoryTransaction[]
  purchase_order_items PurchaseOrderItem[]
  invoice_items    InvoiceItem[]
  sales_order_items SalesOrderItem[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, sku]) // tenant-scoped
  @@map("catalog_items")
}

enum LocationType {
  warehouse
  aisle
  shelf
  bin
  customer_storage
  staging_tote
}

model StorageLocation {
  id           String                 @id @default(uuid())
  tenant_id    String
  tenant       Tenant                 @relation(fields: [tenant_id], references: [id])
  code         String
  name         String
  type         LocationType
  parent_id    String?
  parent       StorageLocation?       @relation("Hierarchy", fields: [parent_id], references: [id])
  children     StorageLocation[]      @relation("Hierarchy")
  stocks       InventoryStock[]
  transactions InventoryTransaction[]
  stagingWorkshopOrders WorkshopOrder[] @relation("WorkshopOrderStagingLocation")
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deletedAt    DateTime?

  @@index([tenant_id])
  @@unique([tenant_id, code]) // tenant-scoped
  @@map("storage_locations")
}

model InventoryStock {
  id                String          @id @default(uuid())
  tenant_id         String
  tenant            Tenant          @relation(fields: [tenant_id], references: [id])
  catalog_item_id   String
  catalog_item      CatalogItem     @relation(fields: [catalog_item_id], references: [id])
  location_id       String
  location          StorageLocation @relation(fields: [location_id], references: [id])
  quantity_on_hand  Int             @default(0)
  quantity_reserved Int             @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, catalog_item_id, location_id]) // tenant-scoped
  @@map("inventory_stocks")
}

enum TransactionType {
  PURCHASE_RECEIPT
  SALE_ISSUE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL_BALANCE
}

model InventoryTransaction {
  id           String          @id @default(uuid())
  tenant_id    String
  tenant       Tenant          @relation(fields: [tenant_id], references: [id])
  item_id      String
  item         CatalogItem     @relation(fields: [item_id], references: [id])
  location_id  String
  location     StorageLocation @relation(fields: [location_id], references: [id])
  quantity     Decimal         @db.Decimal(10, 3) // Signed: positive = add, negative = remove
  type         TransactionType
  reference_id String?         // Invoice #, Workshop Order #, User ID, etc.
  cost_basis   Decimal?        @db.Decimal(10, 2) // For profit calculation
  createdAt    DateTime        @default(now())

  @@map("inventory_transactions")
  @@index([tenant_id])
  @@index([item_id, location_id])
  @@index([type])
  @@index([createdAt])
}

model Vendor {
  id               String   @id @default(uuid())
  tenant_id        String
  tenant           Tenant   @relation(fields: [tenant_id], references: [id])
  name             String
  email            String
  account_number   String
  supportedBrands  Brand[]  @relation("VendorBrands")

  purchase_orders  PurchaseOrder[]
  purchase_invoices PurchaseInvoice[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenant_id])
  @@map("vendors")
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIAL
  COMPLETED
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  tenant_id    String
  tenant       Tenant              @relation(fields: [tenant_id], references: [id])
  vendor_id    String
  vendor       Vendor              @relation(fields: [vendor_id], references: [id])
  status       PurchaseOrderStatus @default(DRAFT)
  order_number String
  items        PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, order_number]) // tenant-scoped
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                String  @id @default(uuid())
  tenant_id         String
  tenant            Tenant  @relation(fields: [tenant_id], references: [id])
  purchase_order_id String
  purchase_order    PurchaseOrder @relation(fields: [purchase_order_id], references: [id])
  catalog_item_id   String
  catalog_item      CatalogItem   @relation(fields: [catalog_item_id], references: [id])
  
  quantity          Int
  quantity_received Int     @default(0)
  quantity_invoiced Decimal @default(0) @db.Decimal(10, 2)
  unit_cost         Decimal @db.Decimal(10, 2)
  
  purchase_invoice_lines PurchaseInvoiceLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenant_id])
  @@map("purchase_order_items")
}

enum CustomerType {
  PRIVATE
  COMPANY
}

model Customer {
  id             String       @id @default(uuid())
  tenant_id      String
  tenant         Tenant       @relation(fields: [tenant_id], references: [id])
  type           CustomerType @default(PRIVATE)
  company_name   String?
  first_name     String
  last_name      String
  email          String?
  phone          String?
  vat_id         String?      // UID-Nummer
  
  address_street String?
  address_city   String?
  address_zip    String?
  address_country String?     @default("AT")
  
  vehicles       Vehicle[]
  invoices       Invoice[]
  sales_orders   SalesOrder[]
  workshop_orders WorkshopOrder[]
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, email]) // tenant-scoped
  @@map("customers")
}

model Vehicle {
  id           String    @id @default(uuid())
  tenant_id    String    
  tenant       Tenant    @relation(fields: [tenant_id], references: [id])
  make         String
  model        String
  year         Int
  engine_code  String?
  vin          String?
  plate        String?
  customer_id  String?
  customer     Customer? @relation(fields: [customer_id], references: [id])
  invoices     Invoice[]
  sales_orders SalesOrder[]
  workshop_orders WorkshopOrder[]
  
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, vin]) // tenant-scoped
  @@map("vehicles")
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  INVOICED
}

model SalesOrder {
  id           String           @id @default(uuid())
  tenant_id    String
  tenant       Tenant           @relation(fields: [tenant_id], references: [id])
  order_number String           // e.g., SO-2026-001
  customer_id  String
  customer     Customer         @relation(fields: [customer_id], references: [id])
  vehicle_id   String?
  vehicle      Vehicle?         @relation(fields: [vehicle_id], references: [id])
  
  status       SalesOrderStatus @default(DRAFT)
  total_amount Decimal          @db.Decimal(10, 2)
  notes        String?
  
  items        SalesOrderItem[]
  invoice      Invoice?

  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, id])
  @@unique([tenant_id, order_number]) // tenant-scoped
  @@map("sales_orders")
}

model SalesOrderItem {
  id              String       @id @default(uuid())
  tenant_id       String
  tenant          Tenant       @relation(fields: [tenant_id], references: [id])
  sales_order_id  String
  sales_order     SalesOrder   @relation(fields: [sales_order_id], references: [id], onDelete: Cascade)
  
  catalog_item_id String?
  catalog_item    CatalogItem? @relation(fields: [catalog_item_id], references: [id])
  
  description     String
  quantity        Decimal      @db.Decimal(10, 2)
  unit_price      Decimal      @db.Decimal(10, 2)
  total           Decimal      @db.Decimal(10, 2) // quantity * unit_price
  tax_rate        Decimal      @default(20) @db.Decimal(5, 2)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([tenant_id])
  @@map("sales_order_items")
}

enum InvoiceStatus {
  DRAFT
  FINALIZED
  ISSUED
  PAID
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FLAT_AMOUNT
}

model Invoice {
  id             String        @id @default(uuid())
  tenant_id      String
  tenant         Tenant        @relation(fields: [tenant_id], references: [id])
  invoice_number String?       // Nullable because it's only generated on FINALIZED
  customer_id    String
  customer       Customer      @relation(fields: [customer_id], references: [id])
  vehicle_id     String?
  vehicle        Vehicle?      @relation(fields: [vehicle_id], references: [id])
  sales_order_id String?
  sales_order    SalesOrder?   @relation(fields: [tenant_id, sales_order_id], references: [tenant_id, id])
  workshop_order_id String?
  workshop_order  WorkshopOrder? @relation(fields: [tenant_id, workshop_order_id], references: [tenant_id, id])
  
  status         InvoiceStatus @default(DRAFT)
  date           DateTime      @default(now())
  due_date       DateTime

  global_discount_type  DiscountType?
  global_discount_value Decimal?      @db.Decimal(10, 2)
  
  total_net      Decimal       @db.Decimal(10, 2)
  total_tax      Decimal       @db.Decimal(10, 2)
  total_gross    Decimal       @db.Decimal(10, 2)
  
  notes          String?
  internal_notes String?

  snapshot       Json?

  pdf_storage_bucket   String?
  pdf_storage_key      String?
  pdf_generated_at     DateTime?
  pdf_generation_error String?
  
  items          InvoiceItem[]
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, invoice_number]) // tenant-scoped
  @@unique([tenant_id, sales_order_id]) // tenant-scoped
  @@unique([tenant_id, workshop_order_id]) // tenant-scoped
  @@map("invoices")
}

model InvoiceSequence {
  id        String @id @default(uuid())
  tenant_id String
  tenant    Tenant @relation(fields: [tenant_id], references: [id])
  year      Int
  current   Int    @default(0)

  @@index([tenant_id])
  @@unique([tenant_id, year]) // tenant-scoped
  @@map("invoice_sequences")
}

model InvoiceItem {
  id              String       @id @default(uuid())
  tenant_id       String
  tenant          Tenant       @relation(fields: [tenant_id], references: [id])
  invoice_id      String
  invoice         Invoice      @relation(fields: [invoice_id], references: [id], onDelete: Cascade)
  
  catalog_item_id String?
  catalog_item    CatalogItem? @relation(fields: [catalog_item_id], references: [id])
  
  description        String
  quantity           Decimal      @db.Decimal(10, 2)
  unit_price         Decimal      @db.Decimal(10, 2)
  tax_rate           Decimal      @db.Decimal(5, 2)
  line_discount_type  DiscountType?
  line_discount_value Decimal?      @db.Decimal(10, 2)
  line_total          Decimal?      @db.Decimal(10, 2)
  revenue_group_name String?      // Snapshot for accounting export
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("invoice_items")
  @@index([tenant_id])
  @@index([catalog_item_id])
}

enum PurchaseInvoiceStatus {
  DRAFT
  POSTED
  PAID
}

model PurchaseInvoice {
  id                    String                @id @default(uuid())
  tenant_id             String
  tenant                Tenant                @relation(fields: [tenant_id], references: [id])
  vendor_id             String
  vendor                Vendor                @relation(fields: [vendor_id], references: [id])
  invoice_number        String?
  vendor_invoice_number String
  status                PurchaseInvoiceStatus @default(DRAFT)
  invoice_date          DateTime
  due_date              DateTime
  total_amount          Decimal               @db.Decimal(10, 2)
  
  lines                 PurchaseInvoiceLine[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, invoice_number]) // tenant-scoped
  @@map("purchase_invoices")
}

model PurchaseInvoiceLine {
  id                      String             @id @default(uuid())
  tenant_id               String
  tenant                  Tenant             @relation(fields: [tenant_id], references: [id])
  purchase_invoice_id     String
  purchase_invoice        PurchaseInvoice    @relation(fields: [purchase_invoice_id], references: [id], onDelete: Cascade)
  purchase_order_item_id  String?
  purchase_order_item     PurchaseOrderItem? @relation(fields: [purchase_order_item_id], references: [id])
  
  description             String
  quantity                Decimal            @db.Decimal(10, 2)
  unit_price              Decimal            @db.Decimal(10, 2)
  tax_rate                Decimal            @default(20) @db.Decimal(5, 2)
  line_total              Decimal            @db.Decimal(10, 2)

  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  @@index([tenant_id])
  @@map("purchase_invoice_lines")
}

// ============================================================================
// Workshop Intake
// ============================================================================

enum WorkshopOrderStatus {
  SCHEDULED
  INTAKE
  IN_PROGRESS
  COMPLETED
  INVOICED
}

enum EmployeeRole {
  MECHANIC
  SERVICE_ADVISOR
  PARTS_CLERK
}

model Employee {
  id                      String          @id @default(uuid())
  tenant_id               String
  tenant                  Tenant          @relation(fields: [tenant_id], references: [id])
  name                    String
  role                    EmployeeRole
  is_active               Boolean         @default(true)
  sort_order              Int             @default(0)
  workshopOrdersAsMechanic WorkshopOrder[] @relation("WorkshopOrderMechanic")
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, id])
  @@map("employees")
}

model Bay {
  id             String          @id @default(uuid())
  tenant_id      String
  tenant         Tenant          @relation(fields: [tenant_id], references: [id])
  name           String
  is_active      Boolean         @default(true)
  sort_order     Int             @default(0)
  workshopOrders WorkshopOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([tenant_id])
  @@unique([tenant_id, id])
  @@unique([tenant_id, name]) // tenant-scoped
  @@map("bays")
}

model WorkshopOrder {
  id           String              @id @default(uuid())
  tenant_id    String
  tenant       Tenant              @relation(fields: [tenant_id], references: [id])
  order_number String
  status       WorkshopOrderStatus @default(INTAKE)

  customer_id  String
  customer     Customer            @relation(fields: [customer_id], references: [id])
  vehicle_id   String
  vehicle      Vehicle             @relation(fields: [vehicle_id], references: [id])
  staging_location_id String?
  stagingLocation StorageLocation? @relation("WorkshopOrderStagingLocation", fields: [staging_location_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  mechanic_id  String?
  mechanic     Employee?           @relation("WorkshopOrderMechanic", fields: [mechanic_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  bay_id       String?
  bay          Bay?                @relation(fields: [bay_id], references: [id], onDelete: SetNull, onUpdate: Cascade)

  odometer     Int
  fuel_level   Int                 // 0-100
  reported_issue String?
  notes        String?
  tasks        WorkshopTask[]
  invoice      Invoice?

  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  pdf_storage_bucket   String?
  pdf_storage_key      String?
  pdf_generated_at     DateTime?
  pdf_generation_error String?

  @@index([tenant_id])
  @@unique([tenant_id, id])
  @@unique([tenant_id, order_number]) // tenant-scoped
  @@index([staging_location_id], map: "idx_workshop_orders_staging_location_id")
  @@index([mechanic_id], map: "idx_workshop_orders_mechanic_id")
  @@index([bay_id], map: "idx_workshop_orders_bay_id")
  @@map("workshop_orders")
}

enum WorkshopTaskStatus {
  NOT_STARTED
  IN_PROGRESS
  WAITING_PARTS
  DONE
}

enum WorkshopLineItemType {
  LABOR
  PART
}

model WorkshopTask {
  id                String             @id @default(uuid())
  tenant_id         String
  tenant            Tenant             @relation(fields: [tenant_id], references: [id])
  workshop_order_id String
  workshop_order    WorkshopOrder      @relation(fields: [tenant_id, workshop_order_id], references: [tenant_id, id], onDelete: Cascade)

  title             String
  status            WorkshopTaskStatus @default(NOT_STARTED)
  mechanic_notes    String?

  line_items        WorkshopTaskLineItem[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@map("workshop_tasks")
}

model WorkshopTaskLineItem {
  id                String               @id @default(uuid())
  tenant_id         String
  tenant            Tenant               @relation(fields: [tenant_id], references: [id])
  workshop_task_id  String
  workshop_task     WorkshopTask         @relation(fields: [tenant_id, workshop_task_id], references: [tenant_id, id], onDelete: Cascade)

  type              WorkshopLineItemType
  // For PART this stores SKU/part number; for LABOR this stores a labor code.
  item_no           String
  description       String
  quantity          Decimal              @db.Decimal(10, 2)
  unit_price        Decimal              @db.Decimal(10, 2)
  labor_operation_id String?             @db.Uuid
  labor_operation    LaborOperation?     @relation(fields: [labor_operation_id], references: [id], onDelete: SetNull, onUpdate: Cascade)
  standard_aw        Decimal?            @db.Decimal(10, 2)
  actual_hours       Decimal?            @db.Decimal(10, 2)
  internal_cost_rate Decimal?            @db.Decimal(10, 2)

  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@map("workshop_task_line_items")
  @@index([tenant_id])
  @@index([labor_operation_id])
}

model LaborCategory {
  id                  String            @id @default(uuid()) @db.Uuid
  tenant_id           String
  tenant              Tenant            @relation(fields: [tenant_id], references: [id])
  name                String
  description         String?
  sort_order          Int               @default(0)
  parent_id           String?           @db.Uuid
  parent              LaborCategory?    @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children            LaborCategory[]   @relation("CategoryHierarchy")
  is_active           Boolean           @default(true)
  default_hourly_rate Decimal?          @db.Decimal(10, 2)

  labor_operations    LaborOperation[]

  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@map("labor_categories")
  @@index([tenant_id])
  @@unique([tenant_id, name]) // tenant-scoped
  @@index([parent_id])
}

model LaborOperation {
  id            String         @id @default(uuid()) @db.Uuid
  tenant_id     String
  tenant        Tenant         @relation(fields: [tenant_id], references: [id])
  code          String
  description   String
  standard_aw   Decimal        @db.Decimal(10, 2)
  hourly_rate   Decimal        @db.Decimal(10, 2)
  internal_cost Decimal?       @db.Decimal(10, 2)
  category_id   String?        @db.Uuid
  category      LaborCategory? @relation(fields: [category_id], references: [id], onDelete: Restrict, onUpdate: Cascade)
  is_active     Boolean        @default(true)
  fitments      LaborFitment[]
  task_line_items WorkshopTaskLineItem[]

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("labor_operations")
  @@index([tenant_id])
  @@unique([tenant_id, code]) // tenant-scoped
  @@index([description])
  @@index([code, description])
  @@index([category_id])
  @@index([is_active, description], name: "labor_operations_is_active_description_idx")
}

model LaborFitment {
  id                 String         @id @default(uuid()) @db.Uuid
  labor_operation_id String         @db.Uuid
  labor_operation    LaborOperation @relation(fields: [labor_operation_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  make               String
  model              String
  year_from          Int?
  year_to            Int?
  engine_code        String?

  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("labor_fitments")
  @@index([labor_operation_id])
  @@index([make, model, year_from, year_to, engine_code])
}

model MasterPart {
  id                   String          @id @default(uuid()) @db.Uuid
  supplier_part_number String          @unique
  oem_number           String?
  description          String
  brand                String
  fitments             PartFitment[]
  local_inventory      LocalInventory?

  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  @@map("master_parts")
  @@index([description])
  @@index([supplier_part_number, oem_number, description])
}

model PartFitment {
  id             String     @id @default(uuid()) @db.Uuid
  master_part_id String     @db.Uuid
  master_part    MasterPart @relation(fields: [master_part_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  make           String
  model          String
  year_from      Int?
  year_to        Int?
  engine_code    String?

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@map("part_fitments")
  @@index([master_part_id])
  @@index([make, model, year_from, year_to, engine_code])
}

model LocalInventory {
  id               String     @id @default(uuid()) @db.Uuid
  master_part_id   String     @unique @db.Uuid
  master_part      MasterPart @relation(fields: [master_part_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  quantity_on_hand Int        @default(0)
  bin_location     String?
  cost_price       Decimal    @db.Decimal(10, 2)
  retail_price     Decimal    @db.Decimal(10, 2)

  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@map("local_inventories")
  @@index([quantity_on_hand])
}
