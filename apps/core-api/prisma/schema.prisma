// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["tracing"]
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// Multi-tenant Foundation
// ============================================================================

enum DisplayLanguage {
  de
  en
}

enum TenantPlan {
  STANDARD
  PREMIUM
  ENTERPRISE
}

enum TenantMemberRole {
  OWNER
  ADMIN
  TECH
  SALES
  DEMO
}

enum PlatformAdminRole {
  SUPER_ADMIN
}

model Tenant {
  id         String     @id @default(uuid())
  name       String
  slug       String     @unique
  plan       TenantPlan @default(STANDARD)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  is_active  Boolean    @default(true)
  /// AUT-547 dedicated tenant for self-service landing demos (isolated from QA seed data).
  is_landing_demo_tenant Boolean @default(false)
  /// AUT-413 tenant opt-out for decision live-apply. Only `shadow` is valid; NULL inherits the environment.
  decision_apply_mode String? @db.VarChar(16)
  /// AUT-411 per-key request budget for the public API (requests per 1-minute window, each key).
  api_rate_limit_per_minute Int @default(60)
  /// AUT-576 tenant default UI/document language when user/customer preference is unset.
  default_locale            DisplayLanguage @default(de)
  /// AUT-576 fixed Austrian formatting region (read-only in v1).
  format_locale             String          @default("de-AT") @db.VarChar(8)

  revenueGroups                 RevenueGroup[]
  financeSettings               FinanceSettings?
  voiceTranslationSettings      VoiceTranslationSettings?
  brands                        Brand[]
  catalogItems                  CatalogItem[]
  storageLocations              StorageLocation[]
  inventoryStocks               InventoryStock[]
  inventoryTransactions         InventoryTransaction[]
  vendors                       Vendor[]
  purchaseOrders                PurchaseOrder[]
  purchaseOrderItems            PurchaseOrderItem[]
  customers                     Customer[]
  customerContactPoints         CustomerContactPoint[]
  customerConsents              CustomerConsent[]
  customerCommunicationStates   CustomerCommunicationState[]
  customerConsentUnsubscribeTokens CustomerConsentUnsubscribeToken[]
  vehicles                      Vehicle[]
  vehiclePurchases              VehiclePurchase[]
  vehicleSales                  VehicleSale[]
  vehicleLedgerEntries          VehicleLedgerEntry[]
  vehicleInspectionRecords      VehicleInspectionRecord[]
  inspectionSourceConnections   InspectionSourceConnection[]
  inspectionExchangeImports     InspectionExchangeImport[]
  inspectionReportIdentities    InspectionReportIdentity[]
  externalInspectionResults     ExternalInspectionResult[]
  inspectionExchangeEvents      InspectionExchangeEvent[]
  inspectionCatalogueVersions   InspectionCatalogueVersion[]
  inspectionCatalogueEntries    InspectionCatalogueEntry[]
  inspectionCatalogueActivations TenantInspectionCatalogueActivation[]
  inspectionCatalogueImports    InspectionCatalogueImport[]
  inspectionFindingReferences   InspectionFindingReference[]
  inspectorEvidenceRevisions    InspectorEvidenceRevision[]
  inspectionSupportEvents       InspectionSupportEvent[]
  inspectionDeviceSources       InspectionDeviceSource[]
  inspectionDeviceEvidence      InspectionDeviceEvidence[]
  inspectionMeasurementIdentities InspectionMeasurementIdentity[]
  inspectionMeasurementImports  InspectionMeasurementImport[]
  inspectionMeasurements        InspectionMeasurement[]
  vehicleValuationSnapshots     VehicleValuationSnapshot[]
  vehicleMedia                  VehicleMedia[]
  vehicleEquipmentOptions       VehicleEquipmentOption[]
  vehicleEquipmentSelections    VehicleEquipmentSelection[]
  vehicleEquipmentFreeTextItems VehicleEquipmentFreeTextItem[]
  vehicleListings               VehicleListing[]
  vehicleListingChannels        VehicleListingChannel[]
  vehicleListingPhotos          VehicleListingPhoto[]
  vehicleListingPushSettings    VehicleListingPushSettings?
  vehicleListingChannelDmsSyncs VehicleListingChannelDmsSync[]
  salesOrders                   SalesOrder[]
  salesOrderItems               SalesOrderItem[]
  invoices                      Invoice[]
  invoiceSequences              InvoiceSequence[]
  invoiceItems                  InvoiceItem[]
  creditNotes                   CreditNote[]
  creditNoteItems               CreditNoteItem[]
  creditNoteSequences           CreditNoteSequence[]
  workshopEstimates             WorkshopEstimate[]
  workshopEstimateSequences     WorkshopEstimateSequence[]
  workshopEstimateVersions      WorkshopEstimateVersion[]
  workshopEstimateAssetRefs     WorkshopEstimateBrandAssetReference[]
  notificationOutbox            NotificationOutbox[]
  estimateApprovalTokens        WorkshopEstimateApprovalToken[]
  estimateApprovals             WorkshopEstimateApproval[]
  workshopEstimateOverruns      WorkshopEstimateOverrun[]
  purchaseInvoices              PurchaseInvoice[]
  purchaseInvoiceLines          PurchaseInvoiceLine[]
  inspectionTemplates           InspectionTemplate[]
  inspectionTemplateItems       InspectionTemplateItem[]
  workshopInspections           WorkshopInspection[]
  workshopInspectionItems       WorkshopInspectionItem[]
  workshopMedia                 WorkshopMedia[]
  workshopCheckIns              WorkshopCheckIn[]
  workshopVoiceNoteDrafts       WorkshopVoiceNoteDraft[]
  voiceNoteRateLimits           VoiceNoteRateLimit[]
  workshopOrders                WorkshopOrder[]
  loanerVehicles                LoanerVehicle[]
  loanerBookings                LoanerBooking[]
  warrantyClaims                WarrantyClaim[]
  warrantyClaimLines            WarrantyClaimLine[]
  workshopTasks                 WorkshopTask[]
  workshopTaskLineItems         WorkshopTaskLineItem[]
  employees                     Employee[]
  bays                          Bay[]
  workshopOpeningHours          WorkshopOpeningHour[]
  workshopHolidays              WorkshopHoliday[]
  employeeLeaveBalances         EmployeeLeaveBalance[]
  leaveRequests                 LeaveRequest[]
  attendanceEvents              AttendanceEvent[]
  employeeWorkSchedules         EmployeeWorkSchedule[]
  employeeWorkScheduleDays      EmployeeWorkScheduleDay[]
  laborCategories               LaborCategory[]
  laborPriceGroups              LaborPriceGroup[]
  laborOperations               LaborOperation[]
  laborEntries                  LaborEntry[]
  catalogProviderSettings       CatalogProviderSettings?
  catalogOemConcerns            CatalogOemConcern[]
  catalogOemConcernMakes        CatalogOemConcernMake[]
  vehicleMakeAliases            VehicleMakeAlias[]
  auditLogs                     AuditLog[]
  agentActionLogs               AgentActionLog[]
  decisionShadowLogs            DecisionShadowLog[]
  memberships                   TenantMember[]
  siteMemberships               SiteMembership[]
  partsReservations             PartsReservation[]
  partsRequisitions             PartsRequisition[]
  partsRequisitionLines         PartsRequisitionLine[]
  activeUsers                   User[]                         @relation("UserActiveTenant")
  legalEntities                 LegalEntity[]
  legalEntityAccountingProfiles LegalEntityAccountingProfile[]
  accountingExports             AccountingExport[]
  sites                         Site[]
  stockTransfers                StockTransfer[]
  stockTransferLines            StockTransferLine[]
  stockTransferCommands         StockTransferCommand[]
  documentBrandProfiles         DocumentBrandProfile[]
  documentBrandAssets           DocumentBrandAsset[]
  invoiceBrandAssetReferences   InvoiceBrandAssetReference[]
  documentBrandQuotaEvents      DocumentBrandQuotaEvent[]
  documentBrandQuotaLocks       DocumentBrandQuotaLock[]
  tyreSets                      TyreSet[]
  tyreSetEvents                 TyreSetEvent[]
  tyreStorageSettings           TyreStorageSettings?
  documentBrandExtractions      DocumentBrandExtraction[]
  importJobs                    ImportJob[]
  importJobRows                 ImportJobRow[]
  externalIdMappings            ExternalIdMapping[]
  importMappingProfiles         ImportMappingProfile[]
  agentPolicyRules              AgentPolicyRule[]
  agentProposals                AgentProposal[]
  workshopCommandPresets        WorkshopCommandPreset[]
  mcpWriteCommandReceipts       McpWriteCommandReceipt[]
  domainEvents                  DomainEvent[]
  domainEventConsumerProgress   DomainEventConsumerProgress[]
  domainEventConsumerDeliveries DomainEventConsumerDelivery[]
  registrationDocumentIntakes   RegistrationDocumentIntake[]
  registrationIntakeBytePurges  RegistrationIntakeBytePurge[]
  payments                      Payment[]
  fiscalRegisters               FiscalRegister[]
  fiscalReceipts                FiscalReceipt[]
  vendorArticles                VendorArticle[]
  marginRules                   MarginRule[]
  catalogPriceHistories         CatalogPriceHistory[]
  tenantApiKeys                 TenantApiKey[]

  @@map("tenants")
}

enum AgentPolicyTier {
  AUTO
  PROPOSE
  HUMAN_ONLY
}

model AgentPolicyRule {
  id              String           @id @default(uuid())
  tenant_id       String?
  tenant          Tenant?          @relation(fields: [tenant_id], references: [id])
  action_type     String
  tier            AgentPolicyTier
  conditions_json Json             @default("{}")
  enabled         Boolean          @default(true)
  version         Int
  created_by      String?
  created_at      DateTime         @default(now())
  updated_at      DateTime         @updatedAt

  @@unique([tenant_id, id])
  @@unique([tenant_id, action_type, version])
  @@index([tenant_id, action_type])
  @@map("agent_policy_rules")
}

enum AgentProposalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  EXECUTED
  FAILED
}

model AgentProposal {
  id           String              @id @default(uuid())
  tenant_id    String
  tenant       Tenant              @relation(fields: [tenant_id], references: [id])
  trace_id     String              @db.Uuid
  action_type  String
  payload_json Json
  preview_json Json?
  created_by_agent String?
  tier         AgentPolicyTier     @default(PROPOSE)
  status       AgentProposalStatus @default(PENDING)
  decided_by   String?
  decided_at   DateTime?
  reason       String?
  expires_at   DateTime            @default(dbgenerated("(now() + '7 days'::interval)"))
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  @@unique([tenant_id, id])
  @@index([tenant_id, status, createdAt])
  @@index([tenant_id, trace_id])
  @@map("agent_proposals")
}

enum McpWriteCommandReceiptStatus {
  IN_FLIGHT
  COMPLETED
}

/// Durable idempotency receipt for MCP AUTO/PROPOSE writes keyed by `command_id`.
model McpWriteCommandReceipt {
  id                   String                       @id @default(uuid())
  tenant_id            String
  tenant               Tenant                       @relation(fields: [tenant_id], references: [id])
  command_id           String                       @db.Uuid
  on_behalf_of_user_id String
  agent_id             String
  site_id              String?
  tool_name            String
  args_fingerprint     String
  status               McpWriteCommandReceiptStatus @default(IN_FLIGHT)
  original_trace_id    String                       @db.Uuid
  response_json        Json?
  created_at           DateTime                     @default(now())
  updated_at           DateTime                     @updatedAt

  @@unique([tenant_id, command_id])
  @@index([tenant_id, on_behalf_of_user_id])
  @@index([tenant_id, original_trace_id])
  @@map("mcp_write_command_receipts")
}

model User {
  id                                String                    @id @default(uuid())
  firebaseUid                       String?                   @unique @map("firebase_uid")
  email                             String                    @unique
  firstName                         String?                   @map("first_name")
  lastName                          String?                   @map("last_name")
  active_tenant_id                  String?
  activeTenant                      Tenant?                   @relation("UserActiveTenant", fields: [active_tenant_id], references: [id])
  active_site_id                    String?
  /// AUT-576 self UI language; null follows the active tenant default.
  locale                            DisplayLanguage?
  memberships                       TenantMember[]
  siteMemberships                   SiteMembership[]
  platformAdmin                     PlatformAdmin?
  employees                         Employee[]
  transfersRequested                StockTransfer[]           @relation("StockTransferRequestedBy")
  transfersApproved                 StockTransfer[]           @relation("StockTransferApprovedBy")
  transfersShipped                  StockTransfer[]           @relation("StockTransferShippedBy")
  transfersReceived                 StockTransfer[]           @relation("StockTransferReceivedBy")
  confirmedDocumentBrandProfiles    DocumentBrandProfile[]    @relation("DocumentBrandConfirmedBy")
  requestedDocumentBrandExtractions DocumentBrandExtraction[] @relation("DocumentBrandExtractionRequestedBy")
  capturedRegistrationIntakes       RegistrationDocumentIntake[] @relation("RegistrationIntakeCapturedBy")
  createdTenantApiKeys              TenantApiKey[]            @relation("TenantApiKeyCreatedBy")
  revokedTenantApiKeys              TenantApiKey[]            @relation("TenantApiKeyRevokedBy")
  workshopEstimateApprovalsRecorded WorkshopEstimateApproval[] @relation("WorkshopEstimateApprovalRecordedBy")
  workshopEstimateOverrunsNotified  WorkshopEstimateOverrun[]  @relation("WorkshopEstimateOverrunNotifiedBy")
  vehicleMediaCreated               VehicleMedia[]             @relation("VehicleMediaCreatedBy")
  paymentsRecorded                  Payment[]                 @relation("PaymentRecordedBy")
  landingDemoSignInGrants           LandingDemoSignInGrant[]
  createdAt                         DateTime                  @default(now())
  updatedAt                         DateTime                  @updatedAt

  @@index([active_tenant_id])
  @@map("users")
}

model TenantMember {
  id        String           @id @default(uuid())
  tenant_id String
  tenant    Tenant           @relation(fields: [tenant_id], references: [id])
  user_id   String
  user      User             @relation(fields: [user_id], references: [id])
  role      TenantMemberRole
  is_active Boolean          @default(true)
  /// AUT-547 self-service demo memberships expire automatically (enforced in auth session).
  demo_access_expires_at DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  siteMemberships SiteMembership[]

  @@unique([tenant_id, user_id])
  @@index([tenant_id])
  @@index([user_id])
  @@map("tenant_members")
}

/// AUT-547 landing-page demo form submission (privacy-minimal retention; see docs/deletion-policy.md).
model LandingDemoAccessRequest {
  id                  String   @id @default(uuid())
  email               String   @db.VarChar(320)
  name                String   @db.VarChar(200)
  betrieb             String   @db.VarChar(200)
  telefon             String?  @db.VarChar(80)
  nachricht           String?  @db.VarChar(2000)
  consent_recorded_at DateTime
  client_ip_hash      String?  @db.VarChar(64)
  createdAt           DateTime @default(now()) @map("created_at")
  signInGrants        LandingDemoSignInGrant[]

  @@index([email, createdAt(sort: Desc)])
  @@map("landing_demo_access_requests")
}

/// AUT-547 issued magic-link grant for one access request (24h validity; superseded grants invalidated).
model LandingDemoSignInGrant {
  id                String                   @id @default(uuid())
  access_request_id String
  accessRequest     LandingDemoAccessRequest @relation(fields: [access_request_id], references: [id], onDelete: Restrict)
  user_id           String
  user              User                     @relation(fields: [user_id], references: [id], onDelete: Restrict)
  expires_at        DateTime
  consumed_at       DateTime?
  invalidated_at    DateTime?
  createdAt         DateTime                 @default(now()) @map("created_at")

  @@index([user_id, createdAt(sort: Desc)])
  @@index([expires_at])
  @@map("landing_demo_sign_in_grants")
}

/// Durable fixed-window rate limits for unauthenticated public endpoints (AUT-547).
model PublicRateLimitCounter {
  scope        String   @db.VarChar(64)
  key          String   @db.VarChar(128)
  count        Int
  window_start DateTime
  expires_at   DateTime

  @@id([scope, key])
  @@index([expires_at])
  @@map("public_rate_limit_counters")
}

model PlatformAdmin {
  id        String            @id @default(uuid())
  user_id   String            @unique
  user      User              @relation(fields: [user_id], references: [id])
  role      PlatformAdminRole @default(SUPER_ADMIN)
  is_active Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@map("platform_admins")
}

// ============================================================================
// Multi-Location: LegalEntity + Site + SiteMembership (ADR-0022)
// ============================================================================

enum RksvMode {
  OFF
  UNKNOWN
  REQUIRED_EXTERNAL_KASSE
  REQUIRED_ACP_RKSV
}

enum FiscalRegisterEnv {
  TEST
  LIVE
}

enum PaymentStatus {
  PENDING
  UNKNOWN
  SETTLED
  SETTLED_EXTERNAL
  REJECTED
  REVERSED
}

enum PaymentMethod {
  CASH
  CARD
}

enum FiscalReceiptState {
  PENDING
  UNKNOWN
  SIGNED
  REJECTED
}

enum FiscalReceiptType {
  NORMAL
  CANCELLATION
}

model LegalEntity {
  id                          String                        @id @default(uuid())
  tenant_id                   String
  tenant                      Tenant                        @relation(fields: [tenant_id], references: [id])
  name                        String
  country_iso                 LegalEntityCountry
  is_active                   Boolean                       @default(true)
  address_street              String?
  address_line2               String?
  address_zip                 String?
  address_city                String?
  tax_number                  String?
  vat_id                      String?
  iban                        String?
  bic                         String?
  bank_name                   String?
  email                       String?
  phone                       String?
  registration_number         String?
  registration_court          String?
  representatives             String?
  payment_terms_days          Int?
  payment_terms_text          String?
  rksv_mode                   RksvMode                      @default(OFF)
  sites                       Site[]
  fiscal_registers            FiscalRegister[]
  payments                    Payment[]
  accountingProfile           LegalEntityAccountingProfile?
  accountingExports           AccountingExport[]
  documentBrandProfile        DocumentBrandProfile?
  documentBrandAssets         DocumentBrandAsset[]
  documentBrandExtractions    DocumentBrandExtraction[]
  invoiceBrandAssetReferences InvoiceBrandAssetReference[]
  workshopEstimateVersions   WorkshopEstimateVersion[]
  workshopEstimateAssetRefs  WorkshopEstimateBrandAssetReference[]
  invoices                    Invoice[]
  creditNotes                 CreditNote[]
  customerConsents            CustomerConsent[]
  customerCommunicationStates CustomerCommunicationState[]
  customerConsentUnsubscribeTokens CustomerConsentUnsubscribeToken[]
  inspectionSourceConnections       InspectionSourceConnection[]
  createdAt                   DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt

  @@unique([tenant_id, id])
  @@unique([tenant_id, name])
  @@index([tenant_id])
  @@map("legal_entities")
}

model FiscalRegister {
  id                         String            @id @default(uuid())
  tenant_id                  String
  tenant                     Tenant            @relation(fields: [tenant_id], references: [id])
  legal_entity_id            String
  legal_entity               LegalEntity       @relation(fields: [tenant_id, legal_entity_id], references: [tenant_id, id], onDelete: Restrict)
  site_id                    String
  site                       Site              @relation(fields: [tenant_id, site_id], references: [tenant_id, id], onDelete: Restrict)
  provider                   String
  env                        FiscalRegisterEnv
  provider_cash_register_id  String            @db.Uuid
  provider_scu_id            String            @db.Uuid
  provider_state             String
  credentials_secret_ref     String?
  fiscal_receipts            FiscalReceipt[]
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  @@unique([tenant_id, site_id])
  @@unique([tenant_id, id])
  @@index([tenant_id])
  @@map("fiscal_registers")
}

model Payment {
  id                       String         @id @default(uuid())
  tenant_id                String
  tenant                   Tenant         @relation(fields: [tenant_id], references: [id])
  invoice_id               String
  invoice                  Invoice        @relation(fields: [tenant_id, invoice_id], references: [tenant_id, id], onDelete: Restrict)
  site_id                  String
  site                     Site           @relation(fields: [tenant_id, site_id], references: [tenant_id, id], onDelete: Restrict)
  legal_entity_id          String
  legal_entity             LegalEntity    @relation(fields: [tenant_id, legal_entity_id], references: [tenant_id, id], onDelete: Restrict)
  recorded_by_user_id      String?
  recorded_by_user         User?          @relation("PaymentRecordedBy", fields: [recorded_by_user_id], references: [id], onDelete: SetNull)
  status                   PaymentStatus
  method                   PaymentMethod
  amount                   Decimal        @db.Decimal(10, 2)
  currency                 String
  idempotency_key          String
  request_hash             String
  external_receipt_number  String?
  external_receipt_date    DateTime?      @db.Date
  fiscal_receipts          FiscalReceipt[]
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt

  @@unique([tenant_id, idempotency_key])
  @@index([tenant_id, invoice_id, status])
  @@unique([tenant_id, id])
  @@map("payments")
}

model FiscalReceipt {
  id                        String             @id @default(uuid())
  tenant_id                 String
  tenant                    Tenant             @relation(fields: [tenant_id], references: [id])
  payment_id                String
  payment                   Payment            @relation(fields: [tenant_id, payment_id], references: [tenant_id, id], onDelete: Restrict)
  fiscal_register_id        String
  fiscal_register           FiscalRegister     @relation(fields: [tenant_id, fiscal_register_id], references: [tenant_id, id], onDelete: Restrict)
  sign_idempotency_key      String?
  provider_receipt_id       String             @db.Uuid
  receipt_type              FiscalReceiptType
  state                     FiscalReceiptState
  request_body              Json
  response_body             Json?
  provider_http_status      Int?
  provider_error_code       String?
  provider_request_id       String?
  original_fiscal_receipt_id String?
  original_fiscal_receipt   FiscalReceipt?     @relation("FiscalReceiptCancellation", fields: [tenant_id, original_fiscal_receipt_id], references: [tenant_id, id], onDelete: Restrict)
  cancellation_receipts     FiscalReceipt[]    @relation("FiscalReceiptCancellation")
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  @@unique([tenant_id, provider_receipt_id])
  @@unique([tenant_id, sign_idempotency_key])
  @@index([tenant_id, fiscal_register_id, createdAt])
  @@unique([tenant_id, id])
  @@map("fiscal_receipts")
}

enum DocumentBrandAssetPurpose {
  SOURCE
  LOGO
}

enum DocumentBrandAssetState {
  QUARANTINED
  READY
  REJECTED
  DELETING
  DELETED
}

enum DocumentBrandQuotaAction {
  ASSET_UPLOAD
  EXTRACTION
  PREVIEW
}

enum DocumentBrandExtractionState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  DISCARDED
}

model DocumentBrandQuotaEvent {
  id              String                   @id @default(uuid())
  tenant_id       String
  tenant          Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  legal_entity_id String?
  user_id         String?
  action          DocumentBrandQuotaAction
  created_at      DateTime                 @default(now())

  @@index([tenant_id, legal_entity_id, action, created_at])
  @@index([tenant_id, user_id, action, created_at])
  @@map("document_brand_quota_events")
}

model DocumentBrandQuotaLock {
  id         String                   @id @default(uuid())
  tenant_id  String
  tenant     Tenant                   @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  action     DocumentBrandQuotaAction
  scope_key  String
  updated_at DateTime                 @updatedAt

  @@unique([tenant_id, action, scope_key])
  @@map("document_brand_quota_locks")
}

model DocumentBrandAsset {
  id                           String                    @id @default(uuid())
  tenant_id                    String
  tenant                       Tenant                    @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  legal_entity_id              String
  legal_entity                 LegalEntity               @relation(fields: [tenant_id, legal_entity_id], references: [tenant_id, id], onDelete: Restrict)
  source_asset_id              String?
  source_asset                 DocumentBrandAsset?       @relation("DocumentBrandSource", fields: [tenant_id, legal_entity_id, source_asset_id], references: [tenant_id, legal_entity_id, id], onDelete: Restrict)
  derived_assets               DocumentBrandAsset[]      @relation("DocumentBrandSource")
  sourceForExtractions         DocumentBrandExtraction[] @relation("DocumentBrandExtractionSource")
  proposalForExtractions       DocumentBrandExtraction[] @relation("DocumentBrandExtractionProposalLogo")
  purpose                      DocumentBrandAssetPurpose
  state                        DocumentBrandAssetState   @default(QUARANTINED)
  bucket                       String?
  object_key                   String?
  object_generation            String?
  preview_bucket               String?
  preview_object_key           String?
  preview_object_generation    String?
  sha256                       String?
  byte_length                  Int
  detected_mime_type           String?
  pixel_width                  Int?
  pixel_height                 Int?
  original_filename            String?                   @db.VarChar(255)
  quarantine_bucket            String?
  quarantine_object_key        String?
  quarantine_object_generation String?
  validation_attempt_count     Int                       @default(0)
  validation_dispatched_at     DateTime?
  validation_lease_until       DateTime?
  expires_at                   DateTime?
  failure_code                 String?
  /// AUT-413 document type set by decision live-apply (AUTO or approved PROPOSE). NULL until decided.
  document_sort_type           String?                   @db.VarChar(32)
  createdAt                    DateTime                  @default(now())
  updatedAt                    DateTime                  @updatedAt

  draftForProfiles       DocumentBrandProfile[] @relation("DocumentBrandDraftLogo")
  draftSourceForProfiles DocumentBrandProfile[] @relation("DocumentBrandDraftSource")
  activeForProfiles      DocumentBrandProfile[] @relation("DocumentBrandActiveLogo")
  invoiceReferences InvoiceBrandAssetReference[]
  workshopEstimateReferences WorkshopEstimateBrandAssetReference[]

  @@unique([tenant_id, id])
  @@unique([tenant_id, legal_entity_id, id])
  @@unique([tenant_id, bucket, object_key, object_generation])
  @@index([tenant_id, legal_entity_id, state, expires_at])
  @@index([tenant_id, legal_entity_id, source_asset_id])
  @@map("document_brand_assets")
}

model DocumentBrandExtraction {
  id                     String                       @id @default(uuid())
  tenant_id              String
  tenant                 Tenant                       @relation(fields: [tenant_id], references: [id], onDelete: Restrict)
  legal_entity_id        String
  legal_entity           LegalEntity                  @relation(fields: [tenant_id, legal_entity_id], references: [tenant_id, id], onDelete: Restrict)
  draftForProfiles       DocumentBrandProfile[]       @relation("DocumentBrandDraftExtraction")
  source_asset_id        String?
