  "cases": [
    {
      "case_id": "canonical-huber-golf-step1-vehicle",
      "utterance": "Huber Golf morgen 8 Uhr großes Service + Pickerl, Bremsen vorne prüfen, Leihwagen reservieren",
      "active_site_id": "a1000000-0000-4000-8000-000000000010",
      "interpreted_at": "2026-10-15T09:12:00+02:00",
      "expected_outcome": "clarification",
      "expected_error_code": "VEHICLE_AMBIGUOUS",
      "expected_choice_count": 2,
      "expected_choice_labels_contains": ["W-PI 101", "W-PI 102"],
      "notes": "Pilot customer Maria Huber owns two Golf-family vehicles; model token Golf must not auto-pick."
    },
    {
      "case_id": "canonical-huber-golf-step2-after-choice",
      "prior_case_id": "canonical-huber-golf-step1-vehicle",
      "resolution": {
        "choice_id": "choice_vehicle_wpi101",
        "fills": { "vehicle_id": "c3000000-0000-4000-8000-000000000001" }
      },
      "expected_outcome": "proposal",
      "expected_refs": {
        "workshop_intent": "contracts/workshop-intent.v1.example.json",
        "booking_proposal": "fixed-booking-proposal.huber-golf.v1.json",
        "position_plan": "fixed-position-plan.huber-golf.v1.json"
      }
    },
    {
      "case_id": "ambiguous-huber-only",
      "utterance": "Huber morgen 9 Uhr Inspektion",
      "active_site_id": "a1000000-0000-4000-8000-000000000010",
      "interpreted_at": "2026-10-15T14:00:00+02:00",
      "expected_outcome": "clarification",
      "expected_error_code": "CUSTOMER_AMBIGUOUS",
      "expected_choice_count": 2,
      "expected_clarification_shape": "contracts/clarification.v1.example.json"
    },
    {
      "case_id": "ambiguous-two-golf-same-customer",
      "utterance": "Huber Golf morgen 10 Uhr Service",
      "active_site_id": "a1000000-0000-4000-8000-000000000010",
      "interpreted_at": "2026-10-15T14:00:00+02:00",
