    {
      "case_id": "dst-spring-forward",
      "utterance": "Huber W-PI 101 30.3. 8 Uhr Service",
      "active_site_id": "a1000000-0000-4000-8000-000000000010",
      "interpreted_at": "2026-03-29T10:00:00+01:00",
      "expected_outcome": "proposal",
      "expected_scheduled_start_at": "2026-03-30T06:00:00.000Z",
      "notes": "Europe/Vienna DST starts 2026-03-29 02:00→03:00; 30.3. 08:00 local = 06:00Z."
    },
    {
      "case_id": "relative-morgen-at-midnight",
      "utterance": "Huber W-PI 101 morgen 8 Uhr Ölwechsel",
      "active_site_id": "a1000000-0000-4000-8000-000000000010",
      "interpreted_at": "2026-10-16T00:00:00+02:00",
      "expected_outcome": "proposal",
      "expected_local_date": "2026-10-17",
      "expected_error_code": null,
      "notes": "At site-local midnight on 16.10., morgen must mean 17.10., not 16.10."
    },
    {
      "case_id": "unsupported-service",
