{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/.*\\.e2e-spec\\.ts$",
  "setupFiles": ["dotenv/config"],
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "tsconfig.e2e.json" }]
  },
  "transformIgnorePatterns": [
    "node_modules/(?!(jose)/)"
  ],
  "testTimeout": 60000,
  "forceExit": true
}
