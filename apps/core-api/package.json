{
  "name": "core-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../node_modules/@typescript/native/bin/tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "lint:fix": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk --import tsx node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "check:cloudrun-env": "tsx scripts/check-cloudrun-env-contract.ts",
    "lint:prisma-tenant": "tsx scripts/lint-prisma-tenant.ts prisma/schema.prisma",
    "openapi:generate": "ts-node -r tsconfig-paths/register scripts/generate-openapi.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- openapi/openapi.json",
    "gcs:lifecycle": "tsx scripts/apply-gcs-lifecycle.ts",
    "db:seed:platform-admin": "tsx scripts/seed-platform-admin.ts",
    "db:seed:tenant-member": "tsx scripts/seed-tenant-member.ts",
    "db:baseline": "tsx scripts/baseline-prisma-migrations.ts",
    "secrets:pull": "node ../../tools/pull-secrets-from-gsm.mjs --mapping ../../secrets/gsm-mapping.json --target core-api"
  },
  "prisma": {
    "seed": "ts-node -r tsconfig-paths/register prisma/seed.ts"
  },
  "dependencies": {
    "@google-cloud/speech": "^8.0.1",
    "@google-cloud/storage": "^8.0.0",
    "@google-cloud/tasks": "^7.0.0",
    "@google-cloud/translate": "^10.0.1",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.4",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@prisma/extension-accelerate": "^3.0.1",
    "@prisma/instrumentation": "^7.10.0",
    "@sentry/node": "^10.50.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "async-retry": "^1.3.3",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.1",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "pg": "^8.17.2",
    "playwright": "^1.60.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@~7.0.2",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.1",
    "@types/async-retry": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.16.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.6.0",
    "jest": "^30.4.2",
    "prettier": "^3.8.3",
    "prisma": "^7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.10",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript-eslint": "8.67.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/scripts"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": {
            "rootDir": "."
          }
        }
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!(jose)/)"
    ],
    "collectCoverageFrom": [
      "{src,scripts}/**/*.(t|j)s",
      "!**/*.spec.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  },
  "overrides": {
    "js-yaml": "^5.3.0",
    "uuid": "^11.1.1"
  }
}
