# Required at boot for local/development and production (not required in NODE_ENV=test)
DATABASE_URL=

# Runtime pooled URL (Neon -pooler / PgBouncer). NestJS Prisma adapters use this when set
# and fall back to DATABASE_URL. Cloud Run should set this to the pooler endpoint.
DATABASE_URL_POOLED=

# Optional production cutover guard. Set true only after verifying the Neon
# pooled secret and SQL evidence; defaults to disabled for existing UAT.
DATABASE_POOLER_REQUIRED=false

# Optional: API port (default: 3000)
PORT=3000

# Optional: runtime mode (development | test | production)
NODE_ENV=development

# Optional: logger verbosity (debug | info | warn | error)
LOG_LEVEL=info

# Required in production: comma-separated frontend origin(s) for CORS and the
# dashboard-realtime gateway. Optional locally (falls back to Vite dev origins).
FRONTEND_URL=

# Optional: Sentry DSN for server-side error tracking
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.1
ENABLE_SENTRY_DEBUG_ROUTE=false

# Required when generating invoice/workshop PDFs (not validated at boot)
INVOICE_PDF_BUCKET=

# Required when storing mechanic workshop media (not validated at boot)
WORKSHOP_MEDIA_BUCKET=

# Optional: offload PDF generation via GCP Cloud Tasks (recommended for production)
# If CLOUD_TASKS_ENABLED is not set, it defaults to enabled in production when a
# queue is configured, and disabled otherwise.
# CLOUD_TASKS_WORKER_SECRET is required at boot when PDF workers are enabled.
CLOUD_TASKS_ENABLED=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=

# Base URL used by Cloud Tasks to call the internal worker endpoint.
# This should point at the API root (include the global prefix), e.g.:
# CLOUD_TASKS_TARGET_BASE_URL=https://<cloud-run-url>/api
CLOUD_TASKS_TARGET_BASE_URL=

# Shared secret used to protect worker endpoints (sent as `x-cloud-tasks-secret`).
CLOUD_TASKS_WORKER_SECRET=

# Service account email attached to Cloud Tasks HTTP requests via OIDC.
# Must have roles/run.invoker on core-api-pdf-worker. Required when enqueueing in production.
CLOUD_TASKS_INVOKER_SA=

# Optional: inline JSON credentials used by Google Cloud SDKs (Storage, Cloud Tasks, etc.)
# Most production deployments on Cloud Run should rely on Application Default Credentials
# (service account) instead of setting this.
# GCP_CREDENTIALS='{"type":"service_account","project_id":"your-project-id",...}'

# Required at boot for local/development and production.
# Must be a base64-encoded 32-byte key.
SECRET_ENCRYPTION_KEY=

# Business Logic
DEFAULT_VAT_RATE=20

# Optional: Google Cloud Project ID (if not detectable via environment)
# Accepted in production as an alternative to FIREBASE_PROJECT_ID.
# GOOGLE_CLOUD_PROJECT=

# Required in production (or set GOOGLE_CLOUD_PROJECT). Used for bearer token
# verification when it cannot be inferred from Google application credentials.
FIREBASE_PROJECT_ID=auto-core-platform

# Optional: path or identifier for GSM mapping used by local secret pull scripts.
# See docs/google-secret-manager.md and secrets/gsm-mapping.example.json.
GSM_MAPPING_PATH=../../secrets/gsm-mapping.json

# Optional: shared mechanic voice-note upload rate limit (Postgres-backed).
# Every Cloud Run replica reads the same per-mechanic window.
# Tenant transcription uses VoiceTranslationModule (Google Speech/Translate).
# Credentials are stored per tenant, not as a global provider API key.
# VOICE_NOTE_RATE_LIMIT_MAX=10
# VOICE_NOTE_RATE_LIMIT_TTL_SECONDS=60
