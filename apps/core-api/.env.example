# Required: PostgreSQL/Neon connection string
DATABASE_URL=

# Optional: API port (default: 3000)
PORT=3000

# Optional: runtime mode (development | test | production)
NODE_ENV=development

# Optional: logger verbosity (debug | info | warn | error)
LOG_LEVEL=info

# Optional: Sentry DSN for server-side error tracking
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0.1
ENABLE_SENTRY_DEBUG_ROUTE=false

# Required: bucket for storing generated invoice PDFs
INVOICE_PDF_BUCKET=

# Required: bucket for storing mechanic workshop media (photos, videos)
WORKSHOP_MEDIA_BUCKET=

# Optional: offload PDF generation via GCP Cloud Tasks (recommended for production)
# If CLOUD_TASKS_ENABLED is not set, it defaults to enabled in production and disabled otherwise.
CLOUD_TASKS_ENABLED=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=

# Base URL used by Cloud Tasks to call the internal worker endpoint.
# This should point at the API root (include the global prefix), e.g.:
# CLOUD_TASKS_TARGET_BASE_URL=https://<cloud-run-url>/api
CLOUD_TASKS_TARGET_BASE_URL=

# Shared secret used to protect worker endpoints (sent as `x-cloud-tasks-secret`).
CLOUD_TASKS_WORKER_SECRET=

# Optional: inline JSON credentials used by Google Cloud SDKs (Storage, Cloud Tasks, etc.)
# Most production deployments on Cloud Run should rely on Application Default Credentials
# (service account) instead of setting this.
# GCP_CREDENTIALS='{"type":"service_account","project_id":"your-project-id",...}'

# Business Logic
DEFAULT_VAT_RATE=20

# Optional: Google Cloud Project ID (if not detectable via environment)
# GOOGLE_CLOUD_PROJECT=

# Optional: Firebase project ID used for bearer token verification when it cannot
# be inferred from Google application credentials.
FIREBASE_PROJECT_ID=auto-core-platform

# Optional: path or identifier for GSM mapping used by local secret pull scripts.
# See docs/google-secret-manager.md and secrets/gsm-mapping.example.json.
GSM_MAPPING_PATH=../../secrets/gsm-mapping.json
