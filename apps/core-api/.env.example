# Required at boot for local/development and production (not required in NODE_ENV=test)
DATABASE_URL=

# Runtime pooled URL (Neon -pooler / PgBouncer). NestJS Prisma adapters use this when set
# and fall back to DATABASE_URL. Cloud Run should set this to the pooler endpoint.
DATABASE_URL_POOLED=

# Optional production cutover guard. Set true only after verifying the Neon
# pooled secret and SQL evidence; defaults to disabled for existing UAT.
DATABASE_POOLER_REQUIRED=false

# Optional: API port (default: 3000)
PORT=3000

# Optional: runtime mode (development | test | production)
NODE_ENV=development

# Optional: logger verbosity (debug | info | warn | error)
LOG_LEVEL=info

# Required in production: comma-separated frontend origin(s) for CORS and the
# dashboard-realtime gateway. Optional locally (falls back to Vite dev origins).
FRONTEND_URL=

# Optional: Redis URL for multi-instance Socket.IO fan-out.
# Unset locally (in-memory adapter). Production Cloud Run injects GSM secret
# REDIS_URL (Upstash public TLS, rediss://) — no VPC / Memorystore required.
REDIS_URL=

# Optional NestJS Observe APM credentials (@nestjs/observe).
# Telemetry stays off when either value is unset, including production,
# until Cloud Run injects both secrets.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
# Optional service identifier (defaults to core-api when Observe is enabled).
# OBSERVE_SERVICE_ID=core-api

# Model Context Protocol (read-only agent tools). Default off; /api/mcp returns 404 when false.
MCP_SERVER_ENABLED=false

# Optional: Sentry DSN for server-side error tracking
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=
SENTRY_SEND_DEFAULT_PII=false
# Production keeps 0.1. Set 1 for local QA traces (see docs/sentry-tracing.md).
SENTRY_TRACES_SAMPLE_RATE=0.1
ENABLE_SENTRY_DEBUG_ROUTE=false

# Required when generating invoice/workshop PDFs (not validated at boot)
INVOICE_PDF_BUCKET=
INVOICE_BRANDING_WRITER_ENABLED=false

# Customer sending of Kostenvoranschlag (estimates). Keep false until the lawyer approves the legal copy.
CUSTOMER_ESTIMATE_SEND_ENABLED=false
# Public https base of the approval link in the estimate email, without a trailing slash. Required while the send flag is on.
ESTIMATE_APPROVAL_BASE_URL=

# Release gate for the RZL (AT) accounting CSV serializer. Keep false until the RZL import is validated (AUT-368).
ACCOUNTING_EXPORT_RZL_SERIALIZER_ENABLED=false

# Release gate for the BMD (AT) accounting CSV serializer. Keep false until the BMD import is validated (see docs/internal/02-Feature-Specs/Finance/bmd-accounting-export.md).
ACCOUNTING_EXPORT_BMD_SERIALIZER_ENABLED=false

# AutoScout24 DMS API listing push (AUT-572). Default off; tenants also need as24_dms_push_enabled.
VEHICLE_LISTING_AS24_PUSH_ENABLED=false
# Live adapter only (tests/CI use the in-process fake adapter automatically).
# AUTOSCOUT24_DMS_API_BASE_URL=
# AUTOSCOUT24_DMS_API_CREDENTIALS_SECRET_REF=
# AUTOSCOUT24_DMS_HTTP_TIMEOUT_MS=15000
# AUTOSCOUT24_DMS_USE_FAKE_ADAPTER=false

# Private quarantine/source/logo storage for legal-entity document branding
DOCUMENT_BRANDING_BUCKET=

# Letterhead extraction (default disabled until product/operations approves a provider).
# openrouter: OpenRouter vision chat (demo/UAT only; free models may log/train on requests).
# vertex: reserved for future Gemini-on-Vertex activation.
DOCUMENT_BRAND_EXTRACTION_PROVIDER=disabled
# Optional override; default in code is google/gemma-4-31b-it:free
# DOCUMENT_BRAND_EXTRACTION_MODEL=
# Required when DOCUMENT_BRAND_EXTRACTION_PROVIDER=openrouter (GSM secret in deployed environments)
# OPENROUTER_API_KEY=

# Austrian Zulassungsschein intake extraction (default disabled; tests use fake).
# REGISTRATION_DOCUMENT_EXTRACTION_PROVIDER=disabled
# Optional object storage for registration intake page bytes (falls back to WORKSHOP_MEDIA_BUCKET).
# REGISTRATION_INTAKE_BUCKET=

# Decision adapter (AE4): default noop provider, shadow logging off.
# DECISION_PROVIDER=noop
# DECISION_SHADOW_ENABLED=false
# DECISION_OPENROUTER_MODEL=typesafe/jev-1.13
# DECISION_HTTP_TIMEOUT_MS=5000

# Cron scheduler (AUT-715): in-process (default) runs @nestjs/schedule in core-api.
# http disables in-process crons and exposes POST /api/internal/cron/:jobName (OIDC).
# off disables both (pdf-worker). Legacy: SCHEDULER_ENABLED=false implies off when SCHEDULER_MODE is unset.
# SCHEDULER_ENABLED=true
# SCHEDULER_MODE=in-process
# CRON_OIDC_AUDIENCE=https://core-api-PLACEHOLDER.run.app
# CRON_INVOKER_SA_EMAIL=cloud-scheduler-invoker@PROJECT.iam.gserviceaccount.com

# Required when storing mechanic workshop media (not validated at boot)
WORKSHOP_MEDIA_BUCKET=

# Scheduled purge of unattached workshop check-in uploads (AUT-562).
# WORKSHOP_CHECK_IN_ORPHAN_UPLOAD_PURGE_ENABLED=true
# WORKSHOP_CHECK_IN_ORPHAN_UPLOAD_TTL_HOURS=24

# Optional dedicated bucket for dealer vehicle stock photos (falls back to WORKSHOP_MEDIA_BUCKET).
# VEHICLE_MEDIA_BUCKET=
# Optional JSON map of portal variant ids to { maxWidth, maxHeight } (defaults: portal_md 1600, thumbnail 320).
# VEHICLE_MEDIA_PORTAL_VARIANTS_JSON=

# Optional: offload PDF generation via GCP Cloud Tasks (recommended for production)
# If CLOUD_TASKS_ENABLED is not set, it defaults to enabled in production when a
# queue is configured, and disabled otherwise.
# CLOUD_TASKS_WORKER_SECRET is required at boot when PDF workers are enabled.
CLOUD_TASKS_ENABLED=
CLOUD_TASKS_LOCATION=
CLOUD_TASKS_QUEUE=

# Base URL used by Cloud Tasks to call the internal worker endpoint.
# This should point at the API root (include the global prefix), e.g.:
# CLOUD_TASKS_TARGET_BASE_URL=https://<cloud-run-url>/api
CLOUD_TASKS_TARGET_BASE_URL=

# Shared secret used to protect worker endpoints (sent as `x-cloud-tasks-secret`).
CLOUD_TASKS_WORKER_SECRET=

# Service account email attached to Cloud Tasks HTTP requests via OIDC.
# Must have roles/run.invoker on core-api-pdf-worker. Required when enqueueing in production.
CLOUD_TASKS_INVOKER_SA=

# Notification outbox wake-ups (AUT-356). A separate queue, never the PDF queue. Unset means no wake-ups;
# rows wait in the outbox until the queue is set and the recovery sweep runs.
#CLOUD_TASKS_NOTIFICATION_QUEUE=notification-queue
# Where wake-ups are delivered: a service that holds the NOTIFICATION_* keys (core-api itself in v1).
# Never the PDF worker, which must not carry them. Same URL shape as CLOUD_TASKS_TARGET_BASE_URL.
#CLOUD_TASKS_NOTIFICATION_TARGET_BASE_URL=https://<core-api-url>/api
#
# Email sender (AUT-356). Defaults fail closed: off means every due email is recorded as SUPPRESSED.
# fake: the in-memory provider, never allowed in production. live: the real provider, for allowlisted
# recipients only. The real Brevo and SES adapters are stubs until AUT-362 wires an account.
#NOTIFICATION_EMAIL_MODE=off
#NOTIFICATION_EMAIL_PROVIDER=brevo
# Comma list of exact addresses or *@domain. Empty means nothing is sent in live mode.
#NOTIFICATION_EMAIL_RECIPIENT_ALLOWLIST=
# Sender on the ACP domain. Required when the mode is fake or live.
#NOTIFICATION_EMAIL_FROM_ADDRESS=

# Optional: inline JSON credentials used by Google Cloud SDKs (Storage, Cloud Tasks, etc.)
# Most production deployments on Cloud Run should rely on Application Default Credentials
# (service account) instead of setting this.
# GCP_CREDENTIALS='{"type":"service_account","project_id":"your-project-id",...}'

# Required at boot for local/development and production.
# Must be a base64-encoded 32-byte key.
SECRET_ENCRYPTION_KEY=

# Required at boot for local/development and production.
# HMAC secret for signed catalog hit tokens (M2 add-to-order).
CATALOG_HIT_HMAC_SECRET=

# Optional (ADR-0026 public API keys): pepper, used as the scrypt salt for the digests of tenant API key secrets.
# Must be a base64-encoded key of at least 32 bytes. Unset = key creation returns 503 and every API key is rejected.
API_KEY_PEPPER=

# Business Logic
DEFAULT_VAT_RATE=20

# Optional: Google Cloud Project ID (if not detectable via environment)
# Accepted in production as an alternative to FIREBASE_PROJECT_ID.
# GOOGLE_CLOUD_PROJECT=

# Required in production (or set GOOGLE_CLOUD_PROJECT). Used for bearer token
# verification when it cannot be inferred from Google application credentials.
FIREBASE_PROJECT_ID=auto-core-platform

# Optional: path or identifier for GSM mapping used by local secret pull scripts.
# See docs/google-secret-manager.md and secrets/gsm-mapping.example.json.
GSM_MAPPING_PATH=../../secrets/gsm-mapping.json

# Optional: shared mechanic voice-note upload rate limit (Postgres-backed).
# Every Cloud Run replica reads the same per-mechanic window.
# Tenant transcription uses VoiceTranslationModule (Google Speech/Translate).
# Credentials are stored per tenant, not as a global provider API key.
# VOICE_NOTE_RATE_LIMIT_MAX=10
# VOICE_NOTE_RATE_LIMIT_TTL_SECONDS=60

# AUT-547 Self-service landing demo (magic link). Disabled unless LANDING_DEMO_ACCESS_ENABLED=true.
# LANDING_DEMO_ACCESS_ENABLED=false
# Comma-separated Firebase Hosting origins for the public landing page (merged into HTTP CORS).
# LANDING_PAGE_ORIGINS=
# Slug of the isolated demo tenant (seed with npm run db:seed:landing-demo-tenant).
# LANDING_DEMO_TENANT_SLUG=selbstservice-demo
# Operator alert recipient (GSM secret in deployed environments).
# LANDING_DEMO_OPERATOR_EMAIL=
# Firebase email-link continue URL (core-web /login or /login/email-link on QA; both complete the magic link).
# LANDING_DEMO_SIGN_IN_CONTINUE_URL=
# Optional Turnstile (default off).
# LANDING_DEMO_TURNSTILE_ENABLED=false
# LANDING_DEMO_TURNSTILE_SECRET=
# LANDING_DEMO_RATE_LIMIT_IP_MAX=10
# LANDING_DEMO_RATE_LIMIT_IP_TTL_SECONDS=3600
# LANDING_DEMO_RATE_LIMIT_EMAIL_MAX=3
# LANDING_DEMO_RATE_LIMIT_EMAIL_TTL_SECONDS=86400
# LANDING_DEMO_CONSENT_TEXT_VERSION=landing-demo-2026-10
